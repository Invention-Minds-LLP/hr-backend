# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Auth ────────────────────────────────────────────────────────────
# Required. Long random string. App refuses to start if unset.
JWT_SECRET=

# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=

# ── FTP (file storage) ──────────────────────────────────────────────
FTP_HOST=
FTP_USER=
FTP_PASS=
# Some modules read FTP_PASSWORD instead of FTP_PASS — keep both in sync.
FTP_PASSWORD=
# "true" to use FTPS (encrypted). Recommended.
FTP_SECURE=false

# ── SMTP / SMS / other integrations (fill as needed) ────────────────
SMTP_USER=
SMTP_PASS=
