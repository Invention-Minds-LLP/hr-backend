generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                      Int              @id @default(autoincrement())
  employeeCode            String           @unique
  referenceCode           String?
  firstName               String
  lastName                String
  gender                  Gender
  dob                     DateTime
  photoUrl                String?
  phone                   String
  email                   String
  departmentId            Int
  branchId                Int
  dateOfJoining           DateTime
  employmentType          EmploymentType
  probationStartDate      DateTime?
  probationEndDate        DateTime?
  probationStatus         ProbationStatus?
  probationConfirmedOn    DateTime?
  probationConfirmedBy    Int?
  probationRemarks        String?
  employmentStatus        EmploymentStatus
  roleId                  Int
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @default(now()) @updatedAt
  shiftId                 Int?
  sameAsPermanent         Boolean?
  age                     Int?
  bloodGroup              String?
  reportingManager        Int?
  employeeType            String?
  alcohol                 Boolean?
  allergies               String?
  bloodPressure           String?
  bloodSugar              String?
  bmi                     Float?
  cholesterol             String?
  chronicConditions       String?
  emergencyNotes          String?
  exerciseFrequency       String?
  healthIssues            Json?
  height                  Float?
  preEmploymentCheckDate  DateTime?
  preferredHospital       String?
  primaryPhysician        String?
  smoking                 Boolean?
  vaccinations            Json?
  weight                  Float?
  pastSurgeries           String?
  usesGlasses             Boolean?
  visionRemarks           String?
  visionType              String?
  disabilityDescription   String?
  disabilityProofFile     String?
  disabilityProofFileName String?
  disabilityProofUrl      String?
  disabilityType          String?
  hasDisability           Boolean?
  healthCheckReminderSent Boolean?         @default(false)
  healthCheckReminderYear Int?
  designationId           Int?
  inchargeId              Int?
  experience              Int?
  fatherName              String?
  marital                 String?
  totalYearsOfExperience  Int?
  motherName              String?
  alternatePhone          String?
  uanNumber               String?
  panNumber               String?
  aadharNumber            String?
  licenseNumber           String?
  licenseRegDate          DateTime?
  licenseExpiryDate       DateTime?
  geoTrackingEnabled      Boolean?         @default(false)
  geoTrackingConsent      Boolean?         @default(false)
  geoTrackingConsentAt    DateTime?
  experienceType          String?
  overtimeEnabled         Boolean?         @default(false)

  // Access-revocation timestamp. When HR fires/suspends an employee or the
  // resignation cron flips them to RESIGNED, this is set to "now". The auth
  // middleware refuses any JWT whose `iat` is older than this value, so all
  // existing browser sessions die instantly. Independent of `employmentStatus`
  // so we can keep an audit trail of when access was actually killed.
  accessRevokedAt         DateTime?

  Address                  Address[]
  AnnouncementAck          AnnouncementAck[]
  appraisals               AppraisalForm[]
  AssignedTest             AssignedTest[]
  attendances              Attendance[]
  bagChecks                BagCheck[]
  ComplaintAcknowledgement ComplaintAcknowledgement[]
  documents                Document[]
  emergencyContacts        EmergencyContact[]
  Branch                   Branch                      @relation(fields: [branchId], references: [id])
  Department               Department                  @relation(fields: [departmentId], references: [id])
  designation              Designation?                @relation(fields: [designationId], references: [id])
  incharge                 Employee?                   @relation("EmployeeIncharge", fields: [inchargeId], references: [id])
  subordinates             Employee[]                  @relation("EmployeeIncharge")
  role                     Role                        @relation(fields: [roleId], references: [id])
  performedLedgers         LeaveLedger[]               @relation("LedgerPerformedBy")
  EmployeeShiftSetting     EmployeeShiftSetting?
  EmployeeSurvey           EmployeeSurvey[]
  evaluations              EvaluationAttempt[]
  ExitInterview            ExitInterview[]
  Grievance                Grievance[]
  GrievanceComment         GrievanceComment[]
  incidentAsEmployee       Incident[]                  @relation("IncidentEmployee")
  incidentAsReporter       Incident[]                  @relation("IncidentReporter")
  Internship               Internship[]
  LateLoginLog             LateLoginLog[]
  leaveRequests            LeaveRequest[]
  mobileAuthSessions       MobileAuthSession[]
  OvertimeApproval         OvertimeApproval[]
  PerformanceFinalReview   PerformanceFinalReview[]
  PerformanceResponse      PerformanceResponse[]
  PerformanceSummary       PerformanceSummary[]
  permissions              PermissionRequest[]
  poshAccusations          PoshCase[]                  @relation("AccusedCases")
  poshComplaints           PoshCase[]                  @relation("ComplainantCases")
  qualifications           Qualification[]
  ResignationClearance     ResignationClearance[]
  ResignationRequest       ResignationRequest[]
  shiftApprovals           ShiftApproval[]
  requestedShiftApprovals  ShiftApproval[]             @relation("ShiftApprovalRequestedBy")
  shifts                   ShiftAssignment[]
  Training                 Training[]
  TrainingAssignment       TrainingAssignment[]
  TrainingAttendance       TrainingAttendance[]
  TrainingFeedback         TrainingFeedback[]
  User                     User?
  WFHRequest               WFHRequest[]
  sabbaticals              Sabbatical[]
  compOffCredits           CompOffCredit[]
  verifiedItems            ResignationClearanceItem[]
  locationSessions         LocationSession[]
  leaveAccruals            LeaveAccrual[]
  leaveLedgers             LeaveLedger[]
  forcePresentActions      ForcePresentAction[]
  punchCorrections         PunchCorrectionLog[]
  leaveBalanceAdjustments  LeaveBalanceAdjustmentLog[]
  attendanceOverrides      AttendanceOverrideLog[]
  weekOffHolidayOverrides  WeekOffHolidayOverrideLog[]
  appraisalOverrides       AppraisalOverrideLog[]
  salaryStructure          SalaryStructure?
  payslips                 Payslip[]
  attendancePunches        AttendancePunch[]
  weeklyPerformanceReports WeeklyPerformanceReport[]
  weeklyRatings            WeeklyPerformanceRating[]   @relation("WeeklyRatingEmployee")
  incentives               Incentive[]
  loans                    Loan[]
  loanRepayments           LoanRepayment[]
  pips                     EmployeePIP[]
  pipEmailLogs             PIPEmailLog[]
  pipResponses             PIPEmployeeResponse[]
  probationRecords         ProbationRecord[]
  interviewPanels          InterviewPanelMember[]
  referredApplications     Application[]               @relation("ReferredApplications")
  // Manpower-requisition relations — see ManpowerRequisition for direction details.
  manpowerRequisitionsRaised   ManpowerRequisition[]   @relation("ManpowerRaisedBy")
  manpowerRequisitionsHoD      ManpowerRequisition[]   @relation("ManpowerApprovedHoD")
  manpowerRequisitionsSMO      ManpowerRequisition[]   @relation("ManpowerApprovedSMO")
  manpowerRequisitionsHR       ManpowerRequisition[]   @relation("ManpowerReceivedHR")

  @@index([employmentStatus])
  @@index([departmentId])
  @@index([branchId])
  @@index([roleId])
  @@index([firstName])
  @@index([lastName])
  @@index([reportingManager])
  @@index([inchargeId])
  @@index([designationId], map: "Employee_designationId_fkey")
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "EmergencyContact_employeeId_fkey")
}

model Address {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String
  line1      String
  line2      String?
  city       String
  state      String
  zipCode    String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Address_employeeId_fkey")
}

model Qualification {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  degree      String
  institution String
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  degreeName  String?
  grade       String?
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Qualification_employeeId_fkey")
}

model Document {
  id         Int       @id @default(autoincrement())
  employeeId Int
  title      String
  fileUrl    String
  type       String
  expiryDate DateTime?
  category   String
  issueDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Document_employeeId_fkey")
}

model Department {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  isDefaultClearance      Boolean?                  @default(false)
  employees               Employee[]
  Internship              Internship[]
  Job                     Job[]
  PerformanceFinalReview  PerformanceFinalReview[]
  PerformanceFormTemplate PerformanceFormTemplate[]
  PerformanceResponse     PerformanceResponse[]
  PerformanceSummary      PerformanceSummary[]
  Training                Training[]
  resignationClearances   ResignationClearance[]
  clearanceTemplateItems  ClearanceTemplateItem[]
}

model Branch {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  location       String?
  attendanceMode AttendanceMode @default(MOBILE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  employees      Employee[]
}

enum AttendanceMode {
  BIOMETRIC
  MOBILE
  BOTH
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  employees   Employee[]
  permissions Permission[] @relation("PermissionToRole")
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[] @relation("PermissionToRole")
}

model Attendance {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  date               DateTime
  status             String
  checkIn            DateTime?
  checkOut           DateTime?
  createdBy          Int?
  reason             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  approvedAt         DateTime?
  approvedBy         Int?
  attendanceApproval String?
  isForcedPresent    Boolean   @default(false)
  forcePresentId     Int?
  isPunchCorrected   Boolean   @default(false)
  punchCorrectionId  Int?
  isOverridden       Boolean   @default(false)
  overrideId         Int?
  employee           Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status])
}

model AttendanceSyncLog {
  id      Int      @id @default(autoincrement())
  runAt   DateTime @default(now())
  window  String
  success Boolean
  message String?
}

model ForcePresentAction {
  id             Int           @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  leaveRequestId Int?
  daysRestored   Float         @default(1)
  compOffGranted Boolean       @default(false)
  performedBy    Int
  reason         String
  createdAt      DateTime      @default(now())
  employee       Employee      @relation(fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
}

model PunchCorrectionLog {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  originalIn     DateTime?
  originalOut    DateTime?
  correctedIn    DateTime?
  correctedOut   DateTime?
  correctionType String
  reason         String
  performedBy    Int
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [employeeId], references: [id])
}

model LeaveBalanceAdjustmentLog {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  leaveTypeId   Int
  year          Int
  adjustType    String
  days          Float
  balanceBefore Float
  balanceAfter  Float
  reason        String
  performedBy   Int
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model AttendanceOverrideLog {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  originalStatus String?
  newStatus      String
  reason         String
  performedBy    Int
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id])
}

model WeekOffHolidayOverrideLog {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  date         DateTime
  overrideType String
  prevStatus   String?
  newStatus    String
  autoCompOff  Boolean  @default(false)
  reason       String
  performedBy  Int
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model AppraisalOverrideLog {
  id                Int      @id @default(autoincrement())
  appraisalFormId   Int
  employeeId        Int
  cycle             String
  prevOverallScore  Float?
  newOverallScore   Float?
  prevFinalDecision String?
  newFinalDecision  String?
  prevStatus        String?
  newStatus         String?
  prevComments      String?
  newComments       String?
  reason            String
  performedBy       Int
  createdAt         DateTime @default(now())
  employee          Employee @relation(fields: [employeeId], references: [id])
}

model LeaveType {
  id                    Int                         @id @default(autoincrement())
  name                  String                      @unique
  description           String?
  carryForward          Boolean                     @default(false)
  EmployeeLeaveBalance  EmployeeLeaveBalance[]
  LeaveRequest          LeaveRequest[]
  policies              LeavePolicy[]
  leaveAccruals         LeaveAccrual[]
  leaveLedgers          LeaveLedger[]
  balanceAdjustmentLogs LeaveBalanceAdjustmentLog[]
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  leaveTypeId         Int
  startDate           DateTime
  endDate             DateTime
  reason              String
  status              LeaveStatus          @default(PENDING)
  approvedBy          Int?
  isHalfDay           Boolean?             @default(false)
  halfDaySession      HalfDaySession?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  declineReason       String?
  declinedBy          Int?
  approvedDate        DateTime?
  declinedDate        DateTime?
  hodDecidedAt        DateTime?
  hodDecision         ApprovalDecision     @default(PENDING)
  hodNote             String?
  hrDecidedAt         DateTime?
  hrDecision          ApprovalDecision     @default(PENDING)
  hrNote              String?
  inChargeDecidedAt   DateTime?
  inChargeDecision    ApprovalDecision     @default(PENDING)
  inChargeNote        String?
  prescriptionUrl     String?
  cancelledAt         DateTime?
  cancelledBy         Int?
  cancellationReason  String?
  forcePresentActions ForcePresentAction[]
  employee            Employee             @relation(fields: [employeeId], references: [id])
  leaveType           LeaveType            @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

model ShiftTemplate {
  id                   Int                    @id @default(autoincrement())
  name                 String
  shiftType            ShiftType
  startTime            DateTime
  endTime              DateTime
  EmployeeShiftSetting EmployeeShiftSetting[]
  shiftApprovals       ShiftApproval[]
  ShiftAssignment      ShiftAssignment[]
  ShiftRotationItem    ShiftRotationItem[]
}

model ShiftAssignment {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  shiftId      Int
  date         DateTime
  acknowledged Boolean       @default(false)
  assignedBy   Int?
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @default(now()) @updatedAt
  employee     Employee      @relation(fields: [employeeId], references: [id])
  shift        ShiftTemplate @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@index([employeeId, date])
}

model PermissionRequest {
  id                Int               @id @default(autoincrement())
  employeeId        Int
  startTime         DateTime?
  endTime           DateTime?
  reason            String
  status            PermissionStatus  @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  approvedBy        Int?
  approvedDate      DateTime?
  declineReason     String?
  declinedBy        Int?
  declinedDate      DateTime?
  permissionType    PermissionType?
  timing            PermissionTiming?
  day               DateTime
  hodDecidedAt      DateTime?
  hodDecision       ApprovalDecision  @default(PENDING)
  hodNote           String?
  hrDecidedAt       DateTime?
  hrDecision        ApprovalDecision  @default(PENDING)
  hrNote            String?
  inChargeDecidedAt DateTime?
  inChargeDecision  ApprovalDecision  @default(PENDING)
  isHROverride      Boolean           @default(false)
  hrOverrideReason  String?
  cancelledAt       DateTime?
  cancelledBy       Int?
  cancellationReason String?
  employee          Employee          @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "PermissionRequest_employeeId_fkey")
}

model BagCheck {
  id         Int            @id @default(autoincrement())
  employeeId Int
  checkedBy  Int
  date       DateTime
  result     BagCheckResult
  remarks    String?
  imageUrl   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  employee   Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "BagCheck_employeeId_fkey")
}

model QuestionBank {
  id           Int        @id @default(autoincrement())
  name         String
  role         String?
  departmentId Int?
  difficulty   String?
  createdBy    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  questions    Question[]
}

model Question {
  id               Int              @id @default(autoincrement())
  questionBankId   Int
  text             String
  type             String
  weight           Int
  correctAnswerIds String?
  evaluationTestId Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  EvaluationTest   EvaluationTest?  @relation(fields: [evaluationTestId], references: [id])
  questionBank     QuestionBank     @relation(fields: [questionBankId], references: [id])
  options          QuestionOption[]

  @@index([evaluationTestId], map: "Question_evaluationTestId_fkey")
  @@index([questionBankId], map: "Question_questionBankId_fkey")
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId], map: "QuestionOption_questionId_fkey")
}

model EvaluationTest {
  id                    Int                     @id @default(autoincrement())
  name                  String
  questionBankId        Int
  duration              Int
  passingPercent        Int
  maxAttempts           Int
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  activeFrom            DateTime?
  activeTo              DateTime?
  instructions          String?
  isPublished           Boolean?                @default(false)
  level                 String?
  purpose               TestPurpose?
  randomization         RandomizationMode?      @default(NONE)
  role                  String?
  AssignedTest          AssignedTest[]
  CandidateAssignedTest CandidateAssignedTest[]
  questions             Question[]
  TrainingTest          TrainingTest[]
}

model EvaluationAttempt {
  id         Int      @id @default(autoincrement())
  employeeId Int
  testId     Int
  score      Float
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  response   String?  @db.LongText
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "EvaluationAttempt_employeeId_fkey")
}

model AssignedTest {
  id                   Int                 @id @default(autoincrement())
  testId               Int
  employeeId           Int
  assignedBy           Int
  assignedAt           DateTime            @default(now())
  status               String
  attempts             Int                 @default(0)
  completedAt          DateTime?
  deadlineDate         DateTime?
  startedAt            DateTime?
  testDate             DateTime?
  trainingAssignmentId Int?
  employee             Employee            @relation(fields: [employeeId], references: [id])
  test                 EvaluationTest      @relation(fields: [testId], references: [id])
  TrainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])

  @@index([employeeId])
  @@index([testId], map: "AssignedTest_testId_fkey")
  @@index([trainingAssignmentId], map: "AssignedTest_trainingAssignmentId_fkey")
}

model AppraisalForm {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  cycle         String
  status        String   @default("AUTO_DRAFT")
  overallScore  Float?
  finalDecision String?
  finalComments String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  managerId     Int?

  // New fields for enhanced flow
  appraisalStartDate          DateTime?
  appraisalEndDate            DateTime?
  dueDate                     DateTime?
  hrVerifiedBy                Int?
  hrVerifiedAt                DateTime?
  selfAppraisalSubmittedAt       DateTime?
  managerAppraisalSubmittedAt    DateTime?
  managementAppraisalSubmittedAt DateTime?
  hrReviewComments               String?   @db.Text
  hrRecommendations              String?   @db.Text
  hrApprovedBy                   Int?
  hrApprovedAt                   DateTime?

  employee           Employee                @relation(fields: [employeeId], references: [id])
  hrReview           HRAppraisal?
  managerReview      ManagerAppraisal?
  managementReview   ManagementAppraisal?
  selfAppraisal      SelfAppraisal?
  selfAnswers        SelfAppraisalAnswer[]
  editRequests       AppraisalEditRequest[]
  editHistory        AppraisalEditHistory[]

  @@index([employeeId], map: "AppraisalForm_employeeId_fkey")
  @@index([status])
}

model SelfAppraisalQuestion {
  id           Int      @id @default(autoincrement())
  text         String
  category     String?  // CLINICAL | NONCLINICAL | PARAMEDICAL
  section      String?  // Section heading within category
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  answers SelfAppraisalAnswer[]
}

model SelfAppraisal {
  id              Int           @id @default(autoincrement())
  appraisalFormId Int           @unique
  achievements    String?       @db.Text
  goalsObjective  String?       @db.Text
  challenges      String?       @db.Text
  trainingNeeds   String?       @db.Text
  communication   Float?
  teamwork        Float?
  problemSolving  Float?
  initiative      Float?
  reliability     Float?
  overallScore    Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  appraisalForm   AppraisalForm @relation(fields: [appraisalFormId], references: [id])
}

model SelfAppraisalAnswer {
  id              Int      @id @default(autoincrement())
  appraisalFormId Int
  questionId      Int
  rating          Float?
  comments        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  appraisalForm AppraisalForm         @relation(fields: [appraisalFormId], references: [id])
  question      SelfAppraisalQuestion @relation(fields: [questionId], references: [id])

  @@unique([appraisalFormId, questionId])
  @@index([appraisalFormId])
  @@index([questionId])
}

model AppraisalEditRequest {
  id              Int       @id @default(autoincrement())
  appraisalFormId Int
  requestedBy     Int
  requestedAt     DateTime  @default(now())
  reason          String    @db.Text
  requestType     String // SELF, MANAGER
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedBy      Int?
  approvedAt      DateTime?
  rejectionReason String?

  appraisalForm AppraisalForm @relation(fields: [appraisalFormId], references: [id])

  @@index([appraisalFormId])
}

model AppraisalEditHistory {
  id              Int      @id @default(autoincrement())
  appraisalFormId Int
  editedBy        Int
  editedAt        DateTime @default(now())
  editType        String // SELF_APPRAISAL, MANAGER_APPRAISAL
  previousValues  Json
  newValues       Json
  editReason      String?
  approvedBy      Int?

  appraisalForm AppraisalForm @relation(fields: [appraisalFormId], references: [id])

  @@index([appraisalFormId])
}

model ManagerAppraisal {
  id                     Int           @id @default(autoincrement())
  appraisalFormId        Int           @unique
  comments               String?       @db.LongText
  recommendations        String?       @db.LongText
  communication          Float?
  teamwork               Float?
  problemSolving         Float?
  initiative             Float?
  reliability            Float?
  overallScore           Float?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt
  attendanceComments     String?       @db.LongText
  attendanceRating       Float?
  guestServiceComments   String?       @db.LongText
  guestServiceRating     Float?
  independenceComments   String?       @db.LongText
  independenceRating     Float?
  knowledgeOfJobComments String?       @db.LongText
  knowledgeOfJobRating   Float?
  leadershipComments     String?       @db.LongText
  leadershipRating       Float?
  qualityOfWorkComments  String?       @db.LongText
  qualityOfWorkRating    Float?
  recordsComments        String?       @db.LongText
  recordsRating          Float?
  safetyComments         String?       @db.LongText
  safetyRating           Float?
  teamworkComments       String?       @db.LongText
  teamworkRating         Float?
  appraisalForm          AppraisalForm @relation(fields: [appraisalFormId], references: [id])
}

model ManagementAppraisal {
  id                     Int           @id @default(autoincrement())
  appraisalFormId        Int           @unique
  qualityOfWorkRating    Float?
  qualityOfWorkComments  String?       @db.LongText
  knowledgeOfJobRating   Float?
  knowledgeOfJobComments String?       @db.LongText
  teamworkRating         Float?
  teamworkComments       String?       @db.LongText
  independenceRating     Float?
  independenceComments   String?       @db.LongText
  recordsRating          Float?
  recordsComments        String?       @db.LongText
  guestServiceRating     Float?
  guestServiceComments   String?       @db.LongText
  safetyRating           Float?
  safetyComments         String?       @db.LongText
  attendanceRating       Float?
  attendanceComments     String?       @db.LongText
  leadershipRating       Float?
  leadershipComments     String?       @db.LongText
  overallScore           Float?
  comments               String?       @db.LongText
  recommendations        String?       @db.LongText
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt
  appraisalForm          AppraisalForm @relation(fields: [appraisalFormId], references: [id])
}

model HRAppraisal {
  id              Int           @id @default(autoincrement())
  appraisalFormId Int           @unique
  comments        String?
  recommendations String?
  communication   Float?
  teamwork        Float?
  problemSolving  Float?
  initiative      Float?
  reliability     Float?
  overallScore    Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  appraisalForm   AppraisalForm @relation(fields: [appraisalFormId], references: [id])
}

model Notification {
  id         Int                 @id @default(autoincrement())
  employeeId Int?
  message    String
  channel    NotificationChannel
  isRead     Boolean             @default(false)
  createdAt  DateTime            @default(now())
}

model User {
  id            Int            @id @default(autoincrement())
  employeeCode  String         @unique
  username      String         @unique
  passwordHash  String
  role          String
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  loginHistory  LoginHistory[]
  refreshTokens RefreshToken[]
  employee      Employee       @relation(fields: [employeeCode], references: [employeeCode])
}

model LoginHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  attemptedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "LoginHistory_userId_fkey")
}

model WFHRequest {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        WFHStatus        @default(PENDING)
  approvedBy    Int?
  declinedBy    Int?
  declineReason String?
  approvedDate  DateTime?
  declinedDate  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  hodDecidedAt  DateTime?
  hodDecision   ApprovalDecision @default(PENDING)
  hodNote       String?
  hrDecidedAt   DateTime?
  hrDecision    ApprovalDecision @default(PENDING)
  hrNote        String?
  employee      Employee         @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "WFHRequest_employeeId_fkey")
}

model EntitlementPolicy {
  id                    Int      @id @default(autoincrement())
  year                  Int
  leaveEntitlement      Int      @default(0)
  wfhEntitlement        Int      @default(0)
  permissionEntitlement Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @default(now()) @updatedAt
}

model ShiftRotationPattern {
  id                   Int                    @id @default(autoincrement())
  name                 String
  cycleDays            Int
  isActive             Boolean                @default(true)
  source               String? // 'MONTHLY'
  month                Int?
  year                 Int?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  EmployeeShiftSetting EmployeeShiftSetting[]
  shiftApprovals       ShiftApproval[]
  items                ShiftRotationItem[]
}

model ShiftRotationItem {
  id        Int                  @id @default(autoincrement())
  patternId Int
  dayIndex  Int
  shiftId   Int
  pattern   ShiftRotationPattern @relation(fields: [patternId], references: [id])
  shift     ShiftTemplate        @relation(fields: [shiftId], references: [id])

  @@unique([patternId, dayIndex])
  @@index([shiftId], map: "ShiftRotationItem_shiftId_fkey")
}

model EmployeeShiftSetting {
  id                Int                   @id @default(autoincrement())
  employeeId        Int                   @unique
  mode              ShiftAssignMode       @default(FIXED)
  fixedShiftId      Int?
  rotationPatternId Int?
  startDate         DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  employee          Employee              @relation(fields: [employeeId], references: [id])
  fixedShift        ShiftTemplate?        @relation(fields: [fixedShiftId], references: [id])
  rotationPattern   ShiftRotationPattern? @relation(fields: [rotationPatternId], references: [id])

  @@index([fixedShiftId], map: "EmployeeShiftSetting_fixedShiftId_fkey")
  @@index([rotationPatternId], map: "EmployeeShiftSetting_rotationPatternId_fkey")
}

model ResignationRequest {
  id                      Int                       @id @default(autoincrement())
  employeeId              Int
  managerId               Int?
  reason                  String
  additionalNotes         String?
  noticePeriodDays        Int                       @default(30)
  proposedLastWorkingDay  DateTime
  actualLastWorkingDay    DateTime?
  status                  ResignationStatus         @default(SUBMITTED)
  managerDecision         ApprovalDecision          @default(PENDING)
  managerDecidedAt        DateTime?
  managerNote             String?
  hrDecision              ApprovalDecision          @default(PENDING)
  hrDecidedAt             DateTime?
  hrNote                  String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  withdrawnAt             DateTime?
  withdrawnReason         String?
  withdrawDecidedAt       DateTime?
  withdrawDecision        ApprovalDecision?
  withdrawRequestedAt     DateTime?
  withdrawStatusChangedBy Int?
  exitInterview           ExitInterview?
  finalSettlement         FinalSettlement?
  clearances              ResignationClearance[]
  documents               ResignationDocument?
  handoverTasks           ResignationHandoverTask[]
  employee                Employee                  @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
}

model ResignationHandoverTask {
  id            Int                @id @default(autoincrement())
  resignationId Int
  title         String
  description   String?
  assigneeId    Int?
  dueDate       DateTime?
  status        TaskStatus         @default(OPEN)
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  resignation   ResignationRequest @relation(fields: [resignationId], references: [id])

  @@index([resignationId])
  @@index([assigneeId])
  @@index([status])
}

model ResignationClearance {
  id            Int                @id @default(autoincrement())
  resignationId Int
  type          String
  decision      ApprovalDecision   @default(PENDING)
  verifierId    Int?
  note          String?
  decidedAt     DateTime?
  departmentId  Int?
  department    Department?        @relation(fields: [departmentId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  resignation   ResignationRequest @relation(fields: [resignationId], references: [id])
  verifier      Employee?          @relation(fields: [verifierId], references: [id])

  items ResignationClearanceItem[]

  @@unique([resignationId, type])
  @@index([resignationId])
  @@index([verifierId], map: "ResignationClearance_verifierId_fkey")
}

model ResignationDocument {
  id                       Int                @id @default(autoincrement())
  resignationId            Int                @unique
  relievingLetterUrl       String?
  experienceLetterUrl      String?
  otherUrl                 String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @default(now()) @updatedAt
  clearanceCertificateUrl  String?
  clearanceIssuedAt        DateTime?
  clearanceCertificateCode String?            @unique
  resignation              ResignationRequest @relation(fields: [resignationId], references: [id])
}

model ExitInterview {
  id                     Int                @id @default(autoincrement())
  resignationId          Int                @unique
  scheduledAt            DateTime?
  interviewerId          Int?
  notes                  String?
  outcome                String?
  completedAt            DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt
  academicQualification  String?
  attitudeSuperiors      String?
  companyOpinion         String?
  demotivating           String?
  discrimination         Boolean?
  dissatisfaction        String?
  employeeId             Int?
  expectationsMet        String?
  influencedFactors      String?
  jobOpinion             String?
  leastSatisfying        String?
  likedMost              String?
  mostSatisfying         String?
  newJobOffers           String?
  newJobSalaryComparison String?
  nextOrgCategory        String?
  nextOrgIndustry        String?
  nextOrgLocation        String?
  nextOrgName            String?
  nextOrgPosition        String?
  reasonForLeaving       String?
  recommendCompany       Boolean?
  recommendReason        String?
  recruitmentMode        String?
  skillUtilization       String?
  stayEncouragement      String?
  supportReceived        String?
  triggerReason          String?
  vacancySource          String?
  employee               Employee?          @relation(fields: [employeeId], references: [id])
  resignation            ResignationRequest @relation(fields: [resignationId], references: [id])

  @@index([employeeId], map: "ExitInterview_employeeId_fkey")
}

model FinalSettlement {
  id            Int                @id @default(autoincrement())
  resignationId Int                @unique
  status        SettlementStatus   @default(DUE)
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  resignation   ResignationRequest @relation(fields: [resignationId], references: [id])
}

model Job {
  id                    Int                  @id @default(autoincrement())
  title                 String
  departmentId          Int
  location              String?
  headcount             Int                  @default(1)
  status                JobStatus            @default(OPEN)
  createdBy             Int
  backfillForEmployeeId Int?
  // Minimum professional references the candidate must supply before HR
  // can extend a final offer. Per-job so senior/regulated roles can demand more.
  minReferencesRequired Int                  @default(2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  applications          Application[]
  department            Department           @relation(fields: [departmentId], references: [id])
  ManpowerRequisition   ManpowerRequisition?

  @@index([status])
  @@index([departmentId])
  @@index([title])
}

model Candidate {
  id            Int                     @id @default(autoincrement())
  name          String
  email         String                  @unique
  phone         String?
  source        String?
  resumeUrl     String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt
  lastLogin     DateTime?
  passwordHash  String?
  experience    String?
  qualification String?
  address       String?
  applications  Application[]
  loginHistory  CandidateLoginHistory[]

  @@index([name])
  @@index([source])
  @@index([email])
}

model CandidateLoginHistory {
  id          Int       @id @default(autoincrement())
  candidateId Int
  attemptedAt DateTime  @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@index([candidateId], map: "CandidateLoginHistory_candidateId_fkey")
}

model Application {
  id                    Int                     @id @default(autoincrement())
  jobId                 Int
  candidateId           Int
  status                ApplicationStatus       @default(APPLIED)
  currentStage          String?
  rejectReason          RejectReason?
  expectedCtc           Float?
  noticeDays            Int?
  salaryNote            String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  experience            String?
  qualification         String?
  source                String?
  shortlistNote         String?
  // ── Referral (how the application arrived) ─────────────────────
  // `referralType` is structured; legacy `source` String is kept for
  // backward compat and free-text overrides (e.g. specific job-board name).
  referralType          ReferralType?
  referrerEmployeeId    Int?            // FK to Employee — only when INTERNAL
  referrerName          String?         // free text — used for EXTERNAL/AGENCY
  referrerEmail         String?
  referrerPhone         String?
  referrerCompany       String?         // agency name, college, etc.
  referralBonusStatus   ReferralBonusStatus @default(NOT_APPLICABLE)
  referralBonusAmount   Float?
  referralBonusPaidAt   DateTime?
  referralBonusNote     String?         @db.Text  // payout reference / forfeit reason

  // ── DPDP-compliance consent flags ──────────────────────────────
  // Single timestamp covers both reference-checks AND BGV — the candidate
  // signs one consent that authorises both. Split into two fields if
  // policy ever requires separate consent flows.
  referencesConsentAt   DateTime?
  bgvConsentAt          DateTime?

  candidate             Candidate               @relation(fields: [candidateId], references: [id])
  job                   Job                     @relation(fields: [jobId], references: [id])
  referrerEmployee      Employee?               @relation("ReferredApplications", fields: [referrerEmployeeId], references: [id])
  CandidateAssignedTest CandidateAssignedTest[]
  interviews            Interview[]
  offer                 Offer?
  auditLogs             ApplicationAuditLog[]
  references            CandidateReference[]
  bgv                   BackgroundVerification?

  @@index([jobId, status])
  @@index([candidateId])
  @@index([updatedAt])
  @@index([referrerEmployeeId])
  @@index([referralType])
  @@index([referralBonusStatus])
  @@index([status])
  @@index([jobId])
}

// Audit trail of every status change / significant action on an Application.
// Lets HR / management see WHO did WHAT and WHEN — useful for compliance and
// debugging "why did this candidate get rejected?".
model ApplicationAuditLog {
  id            Int      @id @default(autoincrement())
  applicationId Int
  action        String   // e.g. "STATUS_CHANGE", "OFFER_SENT", "INTERVIEW_SCHEDULED"
  fromStatus    String?  // optional previous status (when applicable)
  toStatus      String?  // optional new status (when applicable)
  note          String?  @db.Text
  performedBy   Int?     // employeeId of the user who did it (null = system / candidate)
  performedAt   DateTime @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([performedAt])
  @@index([action])
}

model Interview {
  id                      Int                    @id @default(autoincrement())
  applicationId           Int
  stage                   String
  startTime               DateTime
  endTime                 DateTime
  // DEPRECATED: legacy CSV of panel employee IDs. Kept temporarily for backward
  // compatibility — new code must use the `panel` relation (InterviewPanelMember).
  panelUserIds            String?
  feedbackUrl             String?
  feedbackDue             DateTime?
  feedbackAt              DateTime?
  result                  String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @default(now()) @updatedAt
  candidateAssignedTestId Int?
  application             Application            @relation(fields: [applicationId], references: [id])
  candidateAssignedTest   CandidateAssignedTest? @relation(fields: [candidateAssignedTestId], references: [id])
  InterviewFeedback       InterviewFeedback[]
  InterviewHRReview       InterviewHRReview?
  panel                   InterviewPanelMember[]

  @@index([startTime])
  @@index([applicationId])
  @@index([stage])
  @@index([candidateAssignedTestId])
}

// Junction table replacing the CSV `panelUserIds` field on Interview.
// One row per (interview, employee) pair. This makes overlap queries
// trivial (`InterviewPanelMember.findMany({ where: { employeeId: { in: [...] } } })`)
// and removes the contains-string bug entirely.
model InterviewPanelMember {
  id          Int      @id @default(autoincrement())
  interviewId Int
  employeeId  Int
  createdAt   DateTime @default(now())

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee    Employee  @relation(fields: [employeeId], references: [id])

  @@unique([interviewId, employeeId])
  @@index([employeeId])
  @@index([interviewId])
}

model Offer {
  id             Int          @id @default(autoincrement())
  applicationId  Int          @unique
  status         OfferStatus  @default(DRAFT)
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  declinedAt     DateTime?
  declineReason  String?
  proposedJoinAt DateTime?
  joinOutcome    JoinOutcome?
  noShowReason   String?
  // Offer-letter contents (used to render the PDF + persisted for audit)
  ctc            Float?       // Annual CTC in INR
  joinLocation   String?      // city / branch / hospital
  workMode       String?      // OFFICE / REMOTE / HYBRID
  customNotes    String?      @db.Text   // any extra text HR wants in the letter
  // Email send audit — store CC / BCC the email was sent to
  ccEmails       String?      // CSV
  bccEmails      String?      // CSV
  // Optional URL where the generated PDF was archived (FTP / S3). Null if
  // we only attach to email and regenerate on demand.
  offerLetterUrl String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  application    Application  @relation(fields: [applicationId], references: [id])

  @@index([status])
  @@index([proposedJoinAt])
  @@index([signedAt])
}

// ─── Recruitment: Reference checks ──────────────────────────────────
// Tied to Application (not Candidate) — different roles may require
// different references for the same person.
model CandidateReference {
  id              Int            @id @default(autoincrement())
  applicationId   Int
  refereeName     String
  refereeRelation String         // e.g. "Reporting Manager", "Peer", "HR"
  refereeCompany  String?
  refereeEmail    String?
  refereePhone    String?

  // Check workflow — populated when HR contacts the referee.
  checkStatus     RefCheckStatus @default(PENDING)
  checkedBy       Int?           // Employee.id who performed the check
  checkedAt       DateTime?
  feedback        String?        @db.Text
  rating          Int?           // 1..5 — overall sentiment from the call

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  application     Application    @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([checkStatus])
}

// ─── Recruitment: Background Verification ───────────────────────────
// One BGV record per Application (1:1). The actual checks live as rows
// in BgvCheck so HR can mark each one independently.
model BackgroundVerification {
  id              Int           @id @default(autoincrement())
  applicationId   Int           @unique
  status          BgvStatus     @default(NOT_INITIATED)
  vendor          String?       // "Internal HR" / agency name — free text since no API integration
  vendorRef       String?       // optional vendor case ID for cross-reference
  initiatedBy     Int?          // Employee who clicked "Initiate BGV"
  initiatedAt     DateTime?
  completedAt     DateTime?
  reportUrl       String?       // FTP/S3 URL of the consolidated final report
  overallNote     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  application     Application   @relation(fields: [applicationId], references: [id])
  checks          BgvCheck[]
  documents       BgvDocument[]

  @@index([status])
}

model BgvCheck {
  id           Int             @id @default(autoincrement())
  bgvId        Int
  type         BgvCheckType
  status       BgvCheckStatus  @default(PENDING)
  evidenceUrl  String?
  note         String?         @db.Text
  // Discrepancy resolution audit
  resolutionNote String?       @db.Text
  resolvedBy   Int?            // Employee who marked DISCREPANCY_RESOLVED
  resolvedAt   DateTime?
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  bgv          BackgroundVerification @relation(fields: [bgvId], references: [id])

  @@unique([bgvId, type])      // one row per check-type per BGV
  @@index([bgvId])
  @@index([status])
}

// Documents the candidate provides to support BGV (Aadhaar, PAN, mark-sheets,
// relieving letters, payslips, etc.). Stored separately so HR can collect them
// independently of marking individual checks.
model BgvDocument {
  id          Int       @id @default(autoincrement())
  bgvId       Int
  docType     String    // "AADHAAR" / "PAN" / "MARKSHEET_10" / "RELIEVING_LETTER_<COMPANY>" etc.
  fileName    String
  fileUrl     String
  uploadedBy  Int?      // Employee who attached it (HR), or null if candidate-uploaded
  receivedAt  DateTime  @default(now())

  bgv         BackgroundVerification @relation(fields: [bgvId], references: [id])

  @@index([bgvId])
  @@index([docType])
}

model Announcement {
  id           Int               @id @default(autoincrement())
  title        String
  body         String
  audience     String?
  startsAt     DateTime          @default(now())
  endsAt       DateTime?
  createdBy    Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  attachments  String?
  circularCode String?           @unique
  isPinned     Boolean           @default(false)
  requireAck   Boolean           @default(false)
  type         String?
  acks         AnnouncementAck[]
}

model AnnouncementAck {
  id             Int          @id @default(autoincrement())
  announcementId Int
  employeeId     Int
  acknowledgedAt DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id])

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
}

model Internship {
  id                  Int              @id @default(autoincrement())
  employeeId          Int?
  mentorId            Int?
  startDate           DateTime
  endDate             DateTime?
  status              InternshipStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt
  candidateName       String
  email               String?
  phone               String?
  stipend             Int?
  title               String?
  departmentId        Int?
  certificateCode     String?          @unique
  certificateIssuedAt DateTime?
  Department          Department?      @relation(fields: [departmentId], references: [id])
  employee            Employee?        @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@index([startDate])
  @@index([mentorId])
  @@index([departmentId])
  @@index([employeeId], map: "Internship_employeeId_fkey")
}

model CandidateAssignedTest {
  id             Int                          @id @default(autoincrement())
  applicationId  Int
  candidateId    Int
  testId         Int
  assignedBy     Int
  assignedAt     DateTime                     @default(now())
  testDate       DateTime?
  deadlineDate   DateTime?
  // String for backward compat with existing rows. Application code MUST use
  // the `CandidateTestStatusValues` constant to enforce the same values that
  // would be in an enum (NotStarted / InProgress / Completed / Cancelled).
  status         String                       @default("NotStarted")
  attempts       Int                          @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  score          Float?
  response       String?
  // Same story — kept as String for forward-compat. Allowed: PASS / FAIL / null.
  reviewDecision String?
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedBy     Int?
  application    Application                  @relation(fields: [applicationId], references: [id])
  test           EvaluationTest               @relation(fields: [testId], references: [id])
  Interview      Interview[]

  @@index([applicationId])
  @@index([testId])
  @@index([status])
}

model InterviewFeedback {
  id            Int                     @id @default(autoincrement())
  interviewId   Int
  panelUserId   Int
  name          String
  designation   String?
  jobSkills     Int?
  jobKnowledge  Int?
  attitude      Int?
  communication Int?
  average       Float?
  notes         String?
  signature     String?
  status        InterviewFeedbackStatus @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt
  interview     Interview               @relation(fields: [interviewId], references: [id])

  @@unique([interviewId, panelUserId])
  @@index([interviewId])
  @@index([panelUserId])
  @@index([status])
}

model InterviewHRReview {
  id             Int       @id @default(autoincrement())
  interviewId    Int       @unique
  presentSalary  Int?
  payslip        Boolean?
  expectedSalary Int?
  grossOffer     Int?
  conclusion     String?
  remarks        String?
  reviewerUserId Int?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  expectedDoj    DateTime?
  noticePeriod   Int?
  interview      Interview @relation(fields: [interviewId], references: [id])

  @@index([reviewerUserId])
}

model OvertimeApproval {
  id                Int       @id @default(autoincrement())
  employeeId        Int
  date              DateTime
  minutes           Int
  status            String
  createdAt         DateTime  @default(now())
  approvedAt        DateTime?
  scheduledEnd      DateTime?
  checkOut          DateTime?
  managerStatus     String    @default("PENDING")
  managerApprovedAt DateTime?
  managerId         Int?
  manuallyEntered   Boolean   @default(false)
  manualEntryBy     Int?
  manualEntryReason String?
  employee          Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date], name: "employeeId_date")
}

model EmployeeSurvey {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  date        DateTime
  createdAt   DateTime         @default(now())
