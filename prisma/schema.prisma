// ─── Incident Management enums ──────────────────────────────────────
// `IncidentStatus` tracks where in the workflow a case sits.
// `IncidentOutcome` is filled in when investigation closes — it captures
// the verdict, separate from where in the workflow the case is.
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
  DUPLICATE
  WITHDRAWN
}

enum IncidentOutcome {
  SUBSTANTIATED // proven true ("convicted")
  PARTIALLY_SUBSTANTIATED
  UNSUBSTANTIATED // can't be proven (≠ false)
  FALSE_REPORT // proven knowingly false ("wrongly created")
  WITHDRAWN
  DUPLICATE
  NOT_A_VIOLATION
}

model PIPEmployeeResponse {
  id             Int               @id @default(autoincrement())
  pipId          Int
  employeeId     Int
  method         PIPResponseMethod
  responseText   String            @db.Text
  tokenUsed      String?
  respondedAt    DateTime          @default(now())
  acknowledgedBy Int?
  acknowledgedAt DateTime?
  createdAt      DateTime          @default(now())

  pip      EmployeePIP @relation(fields: [pipId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@index([pipId])
  @@index([employeeId])
}

/// ──────────────────────────────────────────────────────────────────────
///  EMPLOYEE AUDIT TRAIL
///  One row per write to the Employee table. `changes` is a JSON of
///  { field: { from: ..., to: ... } } for updates, the full new row for
///  creates, the full prior row for deletes. `source` distinguishes
///  manual edits from system-driven ones (cron / promotion / resignation).
/// ──────────────────────────────────────────────────────────────────────
model EmployeeAuditLog {
  id                    Int      @id @default(autoincrement())
  employeeId            Int // who got changed
  action                String // CREATE / UPDATE / DELETE
  changes               Json? // {field: {from, to}, ...}
  changedFields         Json? // ['designation','salary'] — denorm for fast filters
  changedBy             Int? // who made the change (null = system / cron)
  changedAt             DateTime @default(now())
  reason                String? // free text — "Annual cycle", "Typo", etc.
  source                String? // WEB / IMPORT / MIGRATION / SYSTEM / PROMOTION / RESIGNATION / ONBOARDING
  causedByPromotionId   Int? // backlink to a promotion record if this change came from one
  causedByResignationId Int? // backlink to a resignation record
  causedByOnboardingId  Int? // backlink to an onboarding record
  ipAddress             String?
  userAgent             String?

  employee          Employee  @relation("EmployeeAuditTarget", fields: [employeeId], references: [id])
  changedByEmployee Employee? @relation("EmployeeAuditAuthor", fields: [changedBy], references: [id])

  @@index([employeeId, changedAt])
  @@index([changedBy])
  @@index([source])
  @@index([causedByPromotionId])
}

/// ──────────────────────────────────────────────────────────────────────
///  API ACCESS LOG — one row per API request (security/forensics trail).
///  Written by the accessLogger middleware (src/middleware/accessLog.ts).
///  `isAnonymous` = no valid JWT was presented; `suspicious` = a security
///  rule flagged it (anonymous hit on a sensitive route, 401/403, etc.).
///  A daily retention cron prunes rows older than ACCESS_LOG_RETENTION_DAYS.
/// ──────────────────────────────────────────────────────────────────────
model ApiAccessLog {
  id          BigInt   @id @default(autoincrement())
  createdAt   DateTime @default(now())
  method      String // GET / POST / PUT / DELETE / PATCH
  path        String   @db.Text // request path (no query string)
  statusCode  Int // final HTTP status
  durationMs  Int // server processing time
  ip          String? // client IP (X-Forwarded-For aware)
  userAgent   String?  @db.Text
  userId      Int? // empId from a valid token, null if anonymous
  isAnonymous Boolean  @default(true) // true = no valid JWT presented
  suspicious  Boolean  @default(false) // true = a security rule flagged it
  reason      String? // which rule(s) flagged it

  @@index([createdAt])
  @@index([ip])
  @@index([suspicious])
  @@index([userId])
}

/// ──────────────────────────────────────────────────────────────────────
///  COMMITTEE — POSH ICC and Grievance Redressal Committee.
///  One row per committee instance (e.g. "ICC 2026", "Grievance Committee").
///  Active members come via CommitteeMember.
/// ──────────────────────────────────────────────────────────────────────
model Committee {
  id        Int      @id @default(autoincrement())
  type      String // 'POSH' | 'GRIEVANCE'
  name      String // "ICC 2026", "Grievance Committee — Plant A"
  scope     String? // 'ORG_WIDE' | branch name | dept name
  termStart DateTime
  termEnd   DateTime
  isActive  Boolean  @default(true)
  notes     String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    CommitteeMember[]
  grievances Grievance[]
  poshCases  PoshCase[]

  @@index([type, isActive])
}

/// ──────────────────────────────────────────────────────────────────────
///  COMMITTEE MEMBER — internal (Employee FK) or external (NGO/lawyer).
///  External members get token-based access in a later phase.
/// ──────────────────────────────────────────────────────────────────────
model CommitteeMember {
  id            Int       @id @default(autoincrement())
  committeeId   Int
  employeeId    Int? // null for external members
  externalName  String?
  externalEmail String?
  externalPhone String? // for WhatsApp / SMS — externals only (internal members use Employee.phone)
  externalOrg   String?
  role          String // 'PRESIDING_OFFICER' | 'CHAIR' | 'MEMBER' | 'EXTERNAL_MEMBER' | 'SECRETARY'
  addedOn       DateTime  @default(now())
  removedOn     DateTime?
  isActive      Boolean   @default(true)

  committee          Committee             @relation(fields: [committeeId], references: [id])
  employee           Employee?             @relation(fields: [employeeId], references: [id])
  hearingAttendances PoshHearingAttendee[]

  @@index([committeeId, isActive])
  @@index([employeeId])
}

// ═════════════════════════════════════════════════════════════════════════════
//  MULTI-COMPANY  +  STATUTORY CONFIG  +  INCOME TAX
//
//  A deployment serves one client, but that client may run several registered
//  legal entities (Spine licenses this as "Additional Company"). Everything
//  that carries a statutory identity — PF/ESI/PT codes, payroll runs, challans,
//  Form 16 — hangs off Company rather than Branch. Branch stays a *location*
//  construct (attendance mode, geography); Company is the *legal* one.
// ═════════════════════════════════════════════════════════════════════════════

/// A registered legal entity. Exactly one row is flagged isDefault — legacy
/// employees and payroll runs with a NULL companyId resolve to it.
model Company {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  legalName String?
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  // Statutory identifiers — printed on challans, returns and Form 16.
  pan                   String?
  tan                   String?
  gstin                 String?
  cin                   String?
  pfEstablishmentCode   String?
  esiEmployerCode       String?
  ptRegistrationNumber  String?
  lwfRegistrationNumber String?

  // Registered address + authorised signatory, used on generated documents.
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  pincode              String?
  signatoryName        String?
  signatoryDesignation String?
  signatoryPlace       String?
  logoUrl              String?

  /// Default recipients for the month-end payroll workbook, comma separated.
  /// Pre-fills the dispatch dialog so nobody retypes the finance address.
  financeEmails String? @db.Text

  /// Day of the month after which attendance is frozen for payroll. Leave or
  /// regularisation applied on or after this day for the CURRENT month lands
  /// after payroll is cut, so the employee is warned up front and HR is told it
  /// will be adjusted next month rather than silently altering a processed
  /// payslip.
  payrollCutoffDay Int @default(25)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employees         Employee[]
  statutoryConfigs  StatutoryConfig[]
  payrollRuns       PayrollRun[]
  taxProfiles       EmployeeTaxProfile[]
  taxDeclarations   TaxDeclaration[]
  form16Records     Form16Record[]
  statutoryFilings  StatutoryFiling[]
  letterTemplates   LetterTemplate[]
  lettersIssued     LetterIssued[]
  assets            Asset[]
  salaryTemplates   SalaryTemplate[]
  loans             Loan[]
  incentives        Incentive[]
  payrollDispatches PayrollDispatch[]

  @@index([isDefault])
}

/// Versioned statutory rates for one company. Payroll picks the row with the
/// latest effectiveFrom <= the run month, so a mid-year rate change applies
/// going forward without touching historic payslips — and without a deploy,
/// which is the whole point of moving these out of payroll.controller.ts.
model StatutoryConfig {
  id            Int      @id @default(autoincrement())
  companyId     Int
  effectiveFrom DateTime
  notes         String?

  // ── Provident Fund ─────────────────────────────────────────────────────────
  pfEnabled         Boolean @default(true)
  pfEmployeeRate    Float   @default(12) // % of PF wage
  pfEmployerRate    Float   @default(12)
  pfWageCeiling     Float   @default(15000)
  // true  -> PF wage is capped at pfWageCeiling (statutory minimum contribution)
  // false -> PF is computed on full basic (current HRMINDS behaviour)
  pfCapAtCeiling    Boolean @default(false)
  pfAdminChargeRate Float   @default(0.5) // employer, % of PF wage
  edliRate          Float   @default(0.5) // employer, % of PF wage
  // Split of the employer 12%: 8.33% to pension (EPS) capped at the ceiling,
  // remainder to PF. Needed for the ECR file, not for net pay.
  epsRate           Float   @default(8.33)

  // ── ESI ────────────────────────────────────────────────────────────────────
  esiEnabled      Boolean @default(true)
  esiEmployeeRate Float   @default(0.75)
  esiEmployerRate Float   @default(3.25)
  esiWageLimit    Float   @default(21000)

  // ── Professional Tax ───────────────────────────────────────────────────────
  // State-specific, so the slabs live as JSON rather than columns:
  //   [{ "upTo": 15000, "amount": 0 }, { "upTo": 20000, "amount": 150 },
  //    { "upTo": null,  "amount": 200, "februaryAmount": 300 }]
  // "upTo": null is the top open-ended slab. februaryAmount covers Maharashtra's
  // February differential. Null slabs -> fall back to the built-in default.
  ptEnabled Boolean @default(true)
  ptState   String?
  ptSlabs   Json?

  // ── Labour Welfare Fund ────────────────────────────────────────────────────
  // Most states collect half-yearly or yearly, not monthly, hence the frequency
  // and the explicit list of months in which it is deducted.
  lwfEnabled         Boolean @default(false)
  lwfState           String?
  lwfEmployeeAmount  Float   @default(0)
  lwfEmployerAmount  Float   @default(0)
  lwfFrequency       String  @default("MONTHLY") // MONTHLY | HALF_YEARLY | YEARLY
  lwfDeductionMonths Json? // e.g. [6, 12] for half-yearly (June & December)

  // ── Gratuity (employer provision, not a deduction) ─────────────────────────
  gratuityEnabled  Boolean @default(true)
  gratuityRate     Float   @default(4.81) // % of basic accrued monthly
  gratuityMinYears Float   @default(5)

  // ── Statutory Bonus (employer provision) ───────────────────────────────────
  bonusEnabled         Boolean @default(true)
  bonusRate            Float   @default(8.33) // % — min 8.33, max 20
  bonusEligibilityWage Float   @default(21000) // eligible if basic+DA <= this
  bonusCalculationCap  Float   @default(7000) // bonus computed on min(wage, cap)

  // ── Leave encashment (employer provision) ──────────────────────────────────
  leaveEncashEnabled  Boolean @default(false)
  leaveEncashDaysYear Float   @default(0) // days accrued per year for provisioning

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, effectiveFrom])
  @@index([companyId])
}

/// Per-employee, per-financial-year tax setup. The regime choice and the
/// auto/manual TDS switch live here rather than on SalaryStructure because both
/// reset every April and must be retained per year for Form 16.
model EmployeeTaxProfile {
  id            Int    @id @default(autoincrement())
  employeeId    Int
  companyId     Int?
  financialYear String // "2026-27"

  regime       String    @default("NEW") // OLD | NEW
  regimeLocked Boolean   @default(false) // set once payroll has run for the FY
  regimeSetAt  DateTime?

  // true  -> engine projects TDS each month (recommended)
  // false -> SalaryStructure.tdsMonthly is used verbatim
  autoComputeTds Boolean @default(true)

  // HRA exemption inputs (Old regime only).
  rentPaidAnnual Float   @default(0)
  metroCity      Boolean @default(false)
  landlordPan    String?

  // Carried into the projection: income and TDS from a previous employer this FY.
  previousEmployerIncome Float @default(0)
  previousEmployerTds    Float @default(0)
  previousEmployerPf     Float @default(0)

  // Other declared income that increases the tax base (e.g. bank interest).
  otherIncome       Float @default(0)
  housePropertyLoss Float @default(0) // positive number; capped at 200000

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  employee  Employee @relation(fields: [employeeId], references: [id])
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([employeeId, financialYear])
  @@index([companyId])
  @@index([financialYear])
}

/// An employee's investment declaration for a financial year. One row per
/// employee per FY; the line items hang off it. Mirrors the request->review
/// shape used by LeaveRequest so the frontend approval pattern is reusable.
model TaxDeclaration {
  id            Int    @id @default(autoincrement())
  employeeId    Int
  companyId     Int?
  financialYear String

  // DRAFT -> SUBMITTED -> APPROVED | PARTIALLY_APPROVED | REJECTED
  status      String    @default("DRAFT")
  submittedAt DateTime?
  reviewedBy  Int?
  reviewedAt  DateTime?
  remarks     String?   @db.Text

  // Denormalised totals so listing screens don't aggregate line items.
  totalDeclared Float @default(0)
  totalApproved Float @default(0)

  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
  employee  Employee             @relation(fields: [employeeId], references: [id])
  company   Company?             @relation(fields: [companyId], references: [id])
  items     TaxDeclarationItem[]

  @@unique([employeeId, financialYear])
  @@index([status])
  @@index([companyId])
  @@index([financialYear])
}

/// One declared investment/deduction line. `section` is the IT Act section the
/// engine groups and caps by (80C, 80D, 80CCD1B, 24B...).
model TaxDeclarationItem {
  id            Int     @id @default(autoincrement())
  declarationId Int
  section       String
  category      String // "LIC Premium", "PPF", "ELSS", ...
  description   String?

  declaredAmount Float @default(0)
  approvedAmount Float @default(0)

  proofUrl    String?
  proofStatus String  @default("PENDING") // PENDING | VERIFIED | REJECTED
  remarks     String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
  declaration TaxDeclaration @relation(fields: [declarationId], references: [id], onDelete: Cascade)

  @@index([declarationId])
  @@index([section])
}

/// A generated Form 16 for one employee/FY. Stores the computed figures as well
/// as the file so the certificate can be re-issued or reconciled without
/// recomputing from payslips.
model Form16Record {
  id            Int    @id @default(autoincrement())
  employeeId    Int
  companyId     Int?
  financialYear String

  regime          String @default("NEW")
  grossSalary     Float  @default(0)
  exemptAllowance Float  @default(0)
  standardDeduct  Float  @default(0)
  chapterViaTotal Float  @default(0)
  taxableIncome   Float  @default(0)
  taxOnIncome     Float  @default(0)
  rebate87A       Float  @default(0)
  surcharge       Float  @default(0)
  educationCess   Float  @default(0)
  totalTaxPayable Float  @default(0)
  tdsDeducted     Float  @default(0)
  balanceTax      Float  @default(0)

  fileUrl      String?
  passwordHint String? // e.g. "PAN (uppercase) + DDMMYYYY date of birth"
  generatedBy  Int?
  generatedAt  DateTime  @default(now())
  emailedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])
  company  Company? @relation(fields: [companyId], references: [id])

  @@unique([employeeId, financialYear])
  @@index([companyId])
  @@index([financialYear])
}

/// A generated statutory return/challan file (PF ECR, ESI, PT, LWF) for one
/// company and period. Keeps an audit trail of what was filed and when.
model StatutoryFiling {
  id        Int    @id @default(autoincrement())
  companyId Int
  type      String // PF_ECR | ESI | PT | LWF
  month     Int
  year      Int

  employeeCount Int     @default(0)
  totalEmployee Float   @default(0) // employee-share total
  totalEmployer Float   @default(0) // employer-share total
  totalAmount   Float   @default(0)
  fileUrl       String?
  status        String  @default("GENERATED") // GENERATED | FILED

  generatedBy Int?
  generatedAt DateTime  @default(now())
  filedAt     DateTime?
  reference   String? // challan / TRRN number once filed

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, type, month, year])
  @@index([companyId])
  @@index([year, month])
}

// ═════════════════════════════════════════════════════════════════════════════
//  PHASE 2 — ARREARS
//
//  SalaryRevision records only previousCtc/newCtc, not the component breakdown,
//  so an arrear cannot be reconstructed from it alone. Instead the engine
//  recomputes each already-published month against the employee's CURRENT
//  salary structure and diffs it against what was actually paid.
//
//  This row exists so the same arrear is never paid twice: once APPLIED it is
//  tied to the payslip that carried it, and the recompute skips the covered
//  period on the next run.
// ═════════════════════════════════════════════════════════════════════════════

model SalaryArrear {
  id         Int  @id @default(autoincrement())
  employeeId Int
  companyId  Int?

  /// Inclusive period the arrear covers.
  fromMonth Int
  fromYear  Int
  toMonth   Int
  toYear    Int

  /// Difference between what the revised structure should have paid and what
  /// the published payslips actually paid, split so the statutory top-up is
  /// auditable rather than buried in one number.
  grossArrear Float @default(0)
  pfArrear    Float @default(0)
  esiArrear   Float @default(0)
  totalArrear Float @default(0)

  /// Per-month breakdown, kept so an employee query years later can be answered
  /// without re-deriving it from payslips that may since have been corrected.
  detail Json?

  /// PENDING → computed, awaiting a payroll run
  /// APPLIED → paid out via appliedPayslipId
  /// CANCELLED → discarded by HR
  status           String    @default("PENDING")
  appliedPayslipId Int?
  appliedAt        DateTime?

  reason     String?
  computedBy Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([companyId])
}

// ═════════════════════════════════════════════════════════════════════════════
//  PHASE 3 — LETTER GENERATION
//
//  Replaces the single hardcoded offer letter with user-designable templates.
//  Body is HTML (authored in the PrimeNG/quill editor) carrying {{tokens}} that
//  are resolved per employee at issue time.
//
//  A template is a living document; an issued letter is a historical fact. So
//  LetterIssued stores the RENDERED html, not a pointer to the template — if HR
//  edits the template next year, letters already handed to employees must not
//  silently change.
// ═════════════════════════════════════════════════════════════════════════════

model LetterTemplate {
  id         Int     @id @default(autoincrement())
  companyId  Int?
  name       String
  /// OFFER | CONFIRMATION | EXPERIENCE | RELIEVING | APPRECIATION | WARNING |
  /// INCREMENT | TRANSFER | CUSTOM — drives grouping and the default token set.
  category   String  @default("CUSTOM")
  subject    String
  /// HTML with {{token}} placeholders. See lib/letterTokens.ts for the catalog.
  bodyHtml   String  @db.LongText
  /// Optional letterhead/footer wrapped around the body on every issue.
  headerHtml String? @db.Text
  footerHtml String? @db.Text

  /// Show the authorised signatory block at the end.
  includeSignature Boolean @default(true)
  isActive         Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company Company?       @relation(fields: [companyId], references: [id])
  issued  LetterIssued[]

  @@index([companyId])
  @@index([category])
  @@index([isActive])
}

/// One letter handed to one employee. Immutable once issued.
model LetterIssued {
  id         Int  @id @default(autoincrement())
  templateId Int?
  employeeId Int
  companyId  Int?

  /// Snapshot at issue time — deliberately NOT re-rendered from the template.
  subject      String
  renderedHtml String  @db.LongText
  templateName String?

  issuedBy  Int?
  issuedAt  DateTime  @default(now())
  emailedAt DateTime?
  /// ISSUED | EMAILED | REVOKED
  status    String    @default("ISSUED")
  remarks   String?

  template LetterTemplate? @relation(fields: [templateId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])
  company  Company?        @relation(fields: [companyId], references: [id])

  @@index([employeeId])
  @@index([templateId])
  @@index([issuedAt])
}

// ═════════════════════════════════════════════════════════════════════════════
//  PHASE 3 — ASSET MANAGEMENT
//
//  Tracks company property issued to employees, and makes it recoverable at
//  exit. The FnF link is the point: an employee should not be able to clear
//  their exit while still holding a laptop.
// ═════════════════════════════════════════════════════════════════════════════

model Asset {
  id        Int    @id @default(autoincrement())
  companyId Int?
  /// Human-facing identifier stencilled on the device. Unique per deployment.
  assetTag  String @unique
  name      String
  /// LAPTOP | DESKTOP | MOBILE | SIM | VEHICLE | FURNITURE | ID_CARD |
  /// ACCESS_CARD | TOOL | OTHER
  category  String @default("OTHER")

  serialNumber String?
  make         String?
  model        String?
  description  String? @db.Text

  purchaseDate DateTime?
  purchaseCost Float     @default(0)
  warrantyEnd  DateTime?
  /// Current book value, for the FnF recovery figure when an asset is lost.
  currentValue Float     @default(0)

  /// AVAILABLE | ALLOCATED | IN_REPAIR | LOST | SCRAPPED | RETIRED
  /// Derived from allocations but denormalised so the register lists fast.
  status String @default("AVAILABLE")

  location String?
  remarks  String? @db.Text

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company     Company?          @relation(fields: [companyId], references: [id])
  allocations AssetAllocation[]

  @@index([companyId])
  @@index([status])
  @@index([category])
}

/// One issue-and-return cycle. History is kept: a laptop passed between three
/// employees has three rows, and only one with returnedOn = null.
model AssetAllocation {
  id         Int @id @default(autoincrement())
  assetId    Int
  employeeId Int

  allocatedOn DateTime  @default(now())
  allocatedBy Int?
  dueOn       DateTime?
  purpose     String?

  returnedOn      DateTime?
  returnedTo      Int?
  /// GOOD | MINOR_DAMAGE | MAJOR_DAMAGE | LOST — drives whether a recovery
  /// amount is charged in the full and final settlement.
  returnCondition String?
  /// Amount to recover from the employee, carried into FnF.
  recoveryAmount  Float     @default(0)
  recoveryWaived  Boolean   @default(false)

  /// ALLOCATED | RETURNED | PENDING_RETURN | LOST
  status  String  @default("ALLOCATED")
  remarks String? @db.Text

  acknowledgedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
}

// ═════════════════════════════════════════════════════════════════════════════
//  SALARY STRUCTURE TEMPLATES
//
//  HR defines a structure once as PERCENTAGES OF MONTHLY GROSS that total
//  exactly 100%, then assigns it to many employees by entering a single figure.
//  That figure may be gross, annual CTC, or net take-home — see
//  api/payroll/calc/salaryTemplate.ts for how each is resolved.
//
//  Two design points that protect accuracy:
//
//  1. ROUNDING. Percentages of an arbitrary gross rarely land on whole rupees.
//     Rounding each component independently makes the parts stop summing to the
//     whole, which is how payroll totals drift. Exactly one component is flagged
//     `isBalancing` and absorbs the remainder, so components always re-add to
//     the gross to the paisa.
//
//  2. FIXED ADD-ONS SIT OUTSIDE THE 100%. LTA, mobile and meal reimbursements
//     are flat monthly amounts, not a share of gross. Folding them into the
//     percentage split would make the same template produce a different basic
//     for two people on the same gross.
// ═════════════════════════════════════════════════════════════════════════════

model SalaryTemplate {
  id          Int     @id @default(autoincrement())
  companyId   Int?
  name        String
  code        String?
  description String? @db.Text

  /// Only GROSS today. Kept explicit so a future CTC-based template is a data
  /// change rather than a schema migration.
  basis String @default("GROSS")

  isActive Boolean @default(false)

  /// Suggested applicability — drives the FILTER on the bulk-assign screen so
  /// HR can pull up "all Nursing / Staff Nurse" in one go. It does NOT auto-apply
  /// to anyone; assignment is always an explicit act.
  departmentId   Int?
  designationId  Int?
  roleId         Int?
  employmentType String?
  branchId       Int?

  /// Statutory applicability written onto each structure created from this
  /// template. An employee-level override still wins.
  pfApplicable  Boolean @default(true)
  esiApplicable Boolean @default(true)
  ptApplicable  Boolean @default(true)

  createdBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  company     Company?                   @relation(fields: [companyId], references: [id])
  department  Department?                @relation(fields: [departmentId], references: [id])
  designation Designation?               @relation(fields: [designationId], references: [id])
  components  SalaryTemplateComponent[]
  assignments SalaryTemplateAssignment[]

  @@index([companyId])
  @@index([isActive])
  @@index([departmentId])
  @@index([designationId])
}

model SalaryTemplateComponent {
  id         Int @id @default(autoincrement())
  templateId Int

  /// Maps onto a SalaryStructure column: basic | hra | medicalAllowance |
  /// travelAllowance | specialAllowance | otherAllowances | lta |
  /// mobileInternet | mealFuel
  key   String
  label String

  /// Share of monthly gross. Percentage components must total exactly 100.
  /// Ignored when isFixed.
  percentage Float @default(0)

  /// Flat monthly amount for reimbursement-style components. These sit OUTSIDE
  /// the 100% and are added on top of gross when computing CTC.
  isFixed     Boolean @default(false)
  fixedAmount Float   @default(0)

  /// Exactly one percentage component carries this. It receives
  /// gross − (sum of the other rounded components), so the split always
  /// reconciles to the gross exactly.
  isBalancing Boolean @default(false)

  orderNo Int @default(0)

  template SalaryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

/// Audit of which template produced an employee's current structure, and on
/// what input. Without this, "why is this person's basic 22,500?" is
/// unanswerable six months later.
model SalaryTemplateAssignment {
  id         Int @id @default(autoincrement())
  templateId Int
  employeeId Int

  /// GROSS | CTC | NET — what HR actually typed.
  inputMode   String @default("GROSS")
  inputAmount Float

  /// Resolved figures at assignment time.
  monthlyGross Float @default(0)
  monthlyCtc   Float @default(0)
  /// Net the engine arrived at. For inputMode NET this is the achieved net,
  /// which can differ from the requested amount at a statutory slab boundary.
  monthlyNet   Float @default(0)
  /// achieved − requested, for NET assignments. Non-zero means the exact net
  /// was unreachable; it is recorded rather than hidden.
  netVariance  Float @default(0)

  effectiveFrom DateTime @default(now())
  assignedBy    Int?
  createdAt     DateTime @default(now())

  template SalaryTemplate @relation(fields: [templateId], references: [id])
  employee Employee       @relation(fields: [employeeId], references: [id])

  @@index([templateId])
  @@index([employeeId])
  @@index([effectiveFrom])
}

// ═════════════════════════════════════════════════════════════════════════════
//  PAYROLL DISPATCH — sending the verified workbook to finance.
//
//  The last mile of the month-end cycle: HR exports the sheet, Finance fills in
//  their columns, HR imports it back, checks the exceptions, and then has to get
//  the final workbook to whoever actually pays people. Until now that step was a
//  manual download-and-attach, which is where the wrong month's file gets sent.
//
//  Every send is recorded with the totals as they stood at that moment, so
//  "which figures did Finance actually receive on the 28th?" is answerable
//  without trusting anyone's sent-items folder.
// ═════════════════════════════════════════════════════════════════════════════

model PayrollDispatch {
  id           Int  @id @default(autoincrement())
  payrollRunId Int
  companyId    Int?

  /// Comma-separated recipients, exactly as sent.
  recipients String  @db.Text
  ccList     String? @db.Text
  subject    String
  note       String? @db.Text

  /// Which sheet formats went out, and whether as a live-formula template or a
  /// values-only snapshot.
  templates String
  mode      String  @default("snapshot")
  fileNames String? @db.Text

  /// Totals frozen at send time. If payroll is later corrected, this row still
  /// shows what Finance was told.
  employeeCount     Int   @default(0)
  totalGross        Float @default(0)
  totalDeductions   Float @default(0)
  totalNet          Float @default(0)
  totalEmployerCost Float @default(0)

  /// SENT | FAILED
  status String  @default("SENT")
  error  String? @db.Text

  sentBy Int?
  sentAt DateTime @default(now())

  run     PayrollRun @relation(fields: [payrollRunId], references: [id])
  company Company?   @relation(fields: [companyId], references: [id])

  @@index([payrollRunId])
  @@index([companyId])
  @@index([sentAt])
}
