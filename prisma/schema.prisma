// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------
// ENUMS
// ----------------------
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PROBATION
}

enum EmploymentStatus {
  ACTIVE
  TERMINATED
  SUSPENDED
  NOTICE_PERIOD
  RESIGNED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WFHStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShiftType {
  MORNING
  EVENING
  NIGHT
  FLEXIBLE
}

enum BagCheckResult {
  CLEARED
  SUSPICIOUS
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum PermissionType {
  PERSONAL
  OFFICIAL
  MEDICAL
  OTHER
}

enum PermissionTiming {
  FULLDAY
  HALFDAY
  HOURLY
}

enum TestPurpose {
  HIRING
  TRAINING
  ASSESSMENT
  OTHER
}

enum RandomizationMode {
  NONE
  SHUFFLE_QUESTIONS
  SHUFFLE_OPTIONS
  BOTH
}

// ----------------------
// CORE ENTITIES
// ----------------------

model Employee {
  id            Int      @id @default(autoincrement())
  employeeCode  String   @unique
  referenceCode String?
  firstName     String
  lastName      String
  gender        Gender
  dob           DateTime
  photoUrl      String?

  // Contact info
  phone             String
  email             String
  emergencyContacts EmergencyContact[]

  // Employment details
  designation      String
  departmentId     Int
  branchId         Int
  dateOfJoining    DateTime
  employmentType   EmploymentType
  probationEndDate DateTime?
  employmentStatus EmploymentStatus
  employeeType     String?

  // Education & qualifications
  qualifications Qualification[]

  // Roles & permissions
  roleId Int
  role   Role @relation(fields: [roleId], references: [id])

  shiftId Int?

  sameAsPermanent Boolean?

  reportingManager Int?
  age              Int?
  bloodGroup       String?

  // Health & Wellness
  preEmploymentCheckDate  DateTime?
  healthCheckReminderYear Int? // e.g., 2025
  healthCheckReminderSent Boolean?  @default(false)
  height                  Float?
  weight                  Float?
  bmi                     Float?
  bloodPressure           String?
  bloodSugar              String?
  cholesterol             String?

  allergies         String?
  chronicConditions String?

  smoking                 Boolean?
  alcohol                 Boolean?
  exerciseFrequency       String?
  visionType              String?
  usesGlasses             Boolean?
  visionRemarks           String?
  hasDisability           Boolean?
  disabilityType          String?
  disabilityDescription   String?
  disabilityProofFile     String?
  disabilityProofFileName String?
  disabilityProofUrl      String?
  pastSurgeries           String?
  preferredHospital       String?
  primaryPhysician        String?
  emergencyNotes          String?

  // JSON fields for dynamic arrays
  healthIssues Json? // [{condition, checkupFrequency, lastCheckupDate}]
  vaccinations Json? // [{vaccineName, vaccinated, firstDose, secondDose, boosterDose, ...}]

  // Documents
  documents Document[]

  // Attendance, leaves, shifts, etc.
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  shifts        ShiftAssignment[]
  permissions   PermissionRequest[]
  bagChecks     BagCheck[]
  evaluations   EvaluationAttempt[]
  appraisals    AppraisalForm[]

  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  Department               Department                 @relation(fields: [departmentId], references: [id])
  Branch                   Branch                     @relation(fields: [branchId], references: [id])
  User                     User?
  Address                  Address[]
  WFHRequest               WFHRequest[]
  AssignedTest             AssignedTest[]
  EmployeeShiftSetting     EmployeeShiftSetting?
  ResignationRequest       ResignationRequest[]
  AnnouncementAck          AnnouncementAck[]
  Internship               Internship[]
  OvertimeApproval         OvertimeApproval[]
  EmployeeSurvey           EmployeeSurvey[]
  ExitInterview            ExitInterview[]
  PerformanceResponse      PerformanceResponse[]
  PerformanceSummary       PerformanceSummary[]
  PerformanceFinalReview   PerformanceFinalReview[]
  Grievance                Grievance[]
  GrievanceComment         GrievanceComment[]
  poshComplaints           PoshCase[]                 @relation("ComplainantCases")
  poshAccusations          PoshCase[]                 @relation("AccusedCases")
  Training                 Training[]
  TrainingAssignment       TrainingAssignment[]
  TrainingFeedback         TrainingFeedback[]
  ComplaintAcknowledgement ComplaintAcknowledgement[]
  EmployeeLeaveBalance     EmployeeLeaveBalance[]
  TrainingAttendance       TrainingAttendance[]
  incidentAsEmployee       Incident[]                 @relation("IncidentEmployee")
  incidentAsReporter       Incident[]                 @relation("IncidentReporter")
  ResignationClearance     ResignationClearance[]

  @@index([employmentStatus])
  @@index([departmentId])
  @@index([branchId])
  @@index([roleId])
  @@index([firstName])
  @@index([lastName])
  @@index([reportingManager])
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  name         String
  phone        String
  relationship String
  employee     Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Address {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String // 'PERMANENT' or 'TEMPORARY'
  line1      String
  line2      String?
  city       String
  state      String
  zipCode    String
  country    String
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Qualification {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  degree      String
  institution String
  year        Int
  grade       String?
  degreeName  String? // e.g., B.Tech, MBA
  employee    Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Document {
  id         Int       @id @default(autoincrement())
  employeeId Int
  title      String
  fileUrl    String
  type       String
  category   String // Identity Proof, Education, Employment Contract, etc.
  issueDate  DateTime? // Optional, e.g., for passports
  expiryDate DateTime?
  employee   Employee  @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  Job                     Job[]
  Internship              Internship[]
  PerformanceFormTemplate PerformanceFormTemplate[]
  PerformanceResponse     PerformanceResponse[]
  PerformanceSummary      PerformanceSummary[]
  PerformanceFinalReview  PerformanceFinalReview[]
  Training                Training[]
}

model Branch {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  location  String?
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ----------------------
// ROLE-BASED ACCESS
// ----------------------

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  employees   Employee[]
  permissions Permission[]
}

model Permission {
  id    Int    @id @default(autoincrement())
  name  String @unique
  roles Role[]
}

// ----------------------
// ATTENDANCE & LEAVE
// ----------------------

model Attendance {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  date               DateTime
  status             String // Present, Absent, Late, HalfDay, etc.
  checkIn            DateTime?
  checkOut           DateTime?
  createdBy          Int? // HR/admin who modified manually
  reason             String?
  attendanceApproval String?
  approvedBy         Int?
  approvedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  employee  Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, date])
  @@index([status])
}

model LeaveType {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique
  description          String?
  carryForward         Boolean                @default(false)
  LeaveRequest         LeaveRequest[]
  EmployeeLeaveBalance EmployeeLeaveBalance[]
}

model LeaveRequest {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  leaveTypeId   Int
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        LeaveStatus      @default(PENDING)
  approvedBy    Int?
  declinedBy    Int?
  declineReason String?
  approvedDate  DateTime?
  declinedDate  DateTime?
  hodDecision   ApprovalDecision @default(PENDING)
  hodDecidedAt  DateTime?
  hodNote       String?

  hrDecision  ApprovalDecision @default(PENDING)
  hrDecidedAt DateTime?
  hrNote      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  employee    Employee         @relation(fields: [employeeId], references: [id])
  leaveType   LeaveType        @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

// ----------------------
// SHIFT MANAGEMENT
// ----------------------

model ShiftTemplate {
  id                   Int                    @id @default(autoincrement())
  name                 String
  shiftType            ShiftType
  startTime            DateTime
  endTime              DateTime
  ShiftAssignment      ShiftAssignment[]
  ShiftRotationItem    ShiftRotationItem[]
  EmployeeShiftSetting EmployeeShiftSetting[]
}

model ShiftAssignment {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  shiftId      Int
  date         DateTime
  assignedBy   Int?
  acknowledged Boolean       @default(false)
  employee     Employee      @relation(fields: [employeeId], references: [id])
  shift        ShiftTemplate @relation(fields: [shiftId], references: [id])

  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@index([shiftId])
  @@index([employeeId, date])
}

// ----------------------
// PERMISSIONS (SHORT-DURATION)
// ----------------------

model PermissionRequest {
  id             Int               @id @default(autoincrement())
  employeeId     Int
  startTime      DateTime?
  endTime        DateTime?
  day            DateTime
  permissionType PermissionType?
  timing         PermissionTiming?
  reason         String
  status         PermissionStatus  @default(PENDING)
  approvedBy     Int?
  declinedBy     Int?
  declineReason  String?
  approvedDate   DateTime?
  declinedDate   DateTime?
  hodDecision    ApprovalDecision  @default(PENDING)
  hodDecidedAt   DateTime?
  hodNote        String?

  hrDecision  ApprovalDecision @default(PENDING)
  hrDecidedAt DateTime?
  hrNote      String?
  employee    Employee         @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ----------------------
// BAG CHECKS (SECURITY)
// ----------------------

model BagCheck {
  id         Int            @id @default(autoincrement())
  employeeId Int
  checkedBy  Int // Security staff ID
  date       DateTime
  result     BagCheckResult
  remarks    String?
  imageUrl   String?
  employee   Employee       @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ----------------------
// EVALUATIONS & QUESTION BANK
// ----------------------

model QuestionBank {
  id           Int        @id @default(autoincrement())
  name         String
  role         String?
  departmentId Int?
  difficulty   String?
  createdBy    Int
  questions    Question[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Question {
  id               Int              @id @default(autoincrement())
  questionBankId   Int
  text             String
  type             String // MCQ, Descriptive, etc.
  weight           Int
  correctAnswerIds String? // store comma-separated IDs or move logic to options table
  questionBank     QuestionBank     @relation(fields: [questionBankId], references: [id])
  EvaluationTest   EvaluationTest?  @relation(fields: [evaluationTestId], references: [id])
  evaluationTestId Int?
  options          QuestionOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)
  question   Question @relation(fields: [questionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model EvaluationTest {
  id             Int                @id @default(autoincrement())
  name           String
  questionBankId Int
  duration       Int
  passingPercent Int
  maxAttempts    Int
  role           String? // e.g., "Engineer"
  level          String? // e.g., "Junior/Mid/Senior"
  purpose        TestPurpose? // HIRING/TRAINING/ASSESSMENT/OTHER
  randomization  RandomizationMode? @default(NONE)

  // Useful extras (optional but recommended)
  instructions String? // test instructions to show before start
  isPublished  Boolean?   @default(false)
  activeFrom   DateTime? // test availability window (if needed)
  activeTo     DateTime?
  questions    Question[]

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt
  AssignedTest          AssignedTest[]
  CandidateAssignedTest CandidateAssignedTest[]
  TrainingTest          TrainingTest[]
}

model EvaluationAttempt {
  id         Int      @id @default(autoincrement())
  employeeId Int
  testId     Int
  score      Float
  status     String // Pass/Fail
  response   String?  @db.LongText
  employee   Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AssignedTest {
  id           Int       @id @default(autoincrement())
  testId       Int
  employeeId   Int
  assignedBy   Int
  assignedAt   DateTime  @default(now())
  testDate     DateTime? // When the test is scheduled to start/be available
  deadlineDate DateTime? // Last date/time to attempt the test
  status       String // NotStarted, InProgress, Completed
  attempts     Int       @default(0)

  startedAt   DateTime? // When user first opened the test
  completedAt DateTime? // When user finished

  employee             Employee            @relation(fields: [employeeId], references: [id])
  test                 EvaluationTest      @relation(fields: [testId], references: [id])
  TrainingAssignment   TrainingAssignment? @relation(fields: [trainingAssignmentId], references: [id])
  trainingAssignmentId Int?

  @@index([employeeId])
}

// ----------------------
// APPRAISAL FORMS
// ----------------------

model AppraisalForm {
  id            Int     @id @default(autoincrement())
  employeeId    Int
  cycle         String // e.g., Annual 2025
  managerId     Int? // explicit link to reporting manager
  status        String // Draft, Submitted, Reviewed, Finalized
  overallScore  Float?
  finalDecision String? // Promotion, Retain, Training Recommended, etc.
  finalComments String? // HR/Management final notes

  // Relations
  employee      Employee          @relation(fields: [employeeId], references: [id])
  selfAppraisal SelfAppraisal?
  managerReview ManagerAppraisal?
  hrReview      HRAppraisal?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SelfAppraisal {
  id              Int     @id @default(autoincrement())
  appraisalFormId Int     @unique
  achievements    String?
  goalsObjective  String?
  challenges      String?
  trainingNeeds   String?

  // Ratings out of 10
  communication  Float?
  teamwork       Float?
  problemSolving Float?
  initiative     Float?
  reliability    Float?
  overallScore   Float?

  appraisalForm AppraisalForm @relation(fields: [appraisalFormId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ManagerAppraisal {
  id              Int     @id @default(autoincrement())
  appraisalFormId Int     @unique
  comments        String?
  recommendations String?

  // Ratings out of 10
  communication  Float?
  teamwork       Float?
  problemSolving Float?
  initiative     Float?
  reliability    Float?
  overallScore   Float?

  // Section-wise rating + comments
  qualityOfWorkRating   Float?
  qualityOfWorkComments String?

  knowledgeOfJobRating   Float?
  knowledgeOfJobComments String?

  teamworkRating   Float?
  teamworkComments String?

  independenceRating   Float?
  independenceComments String?

  recordsRating   Float?
  recordsComments String?

  guestServiceRating   Float?
  guestServiceComments String?

  safetyRating   Float?
  safetyComments String?

  attendanceRating   Float?
  attendanceComments String?

  leadershipRating   Float?
  leadershipComments String?

  appraisalForm AppraisalForm @relation(fields: [appraisalFormId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model HRAppraisal {
  id              Int     @id @default(autoincrement())
  appraisalFormId Int     @unique
  comments        String?
  recommendations String?

  // Ratings out of 10
  communication  Float?
  teamwork       Float?
  problemSolving Float?
  initiative     Float?
  reliability    Float?
  overallScore   Float?

  appraisalForm AppraisalForm @relation(fields: [appraisalFormId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ----------------------
// NOTIFICATIONS
// ----------------------

model Notification {
  id         Int                 @id @default(autoincrement())
  employeeId Int?
  message    String
  channel    NotificationChannel
  isRead     Boolean             @default(false)
  createdAt  DateTime            @default(now())
}

model User {
  id           Int      @id @default(autoincrement())
  employeeCode String   @unique
  employee     Employee @relation(fields: [employeeCode], references: [employeeCode])

  username     String    @unique
  passwordHash String
  role         String
  lastLogin    DateTime?

  loginHistory LoginHistory[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
}

model LoginHistory {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  attemptedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model WFHRequest {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  startDate     DateTime
  endDate       DateTime
  reason        String
  status        WFHStatus @default(PENDING)
  approvedBy    Int?
  declinedBy    Int?
  declineReason String?
  approvedDate  DateTime?
  declinedDate  DateTime?

  hodDecision  ApprovalDecision @default(PENDING)
  hodDecidedAt DateTime?
  hodNote      String?

  hrDecision  ApprovalDecision @default(PENDING)
  hrDecidedAt DateTime?
  hrNote      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model EntitlementPolicy {
  id                    Int @id @default(autoincrement())
  year                  Int // To make it applicable yearly (e.g., 2025)
  leaveEntitlement      Int @default(0) // Total no. of leaves available
  wfhEntitlement        Int @default(0) // Total no. of WFHs available
  permissionEntitlement Int @default(0) // Total no. of permissions available

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum ShiftAssignMode {
  FIXED
  ROTATIONAL
}

model ShiftRotationPattern {
  id                   Int                    @id @default(autoincrement())
  name                 String // e.g., "3-cycle MEN"
  cycleDays            Int // e.g., 3
  items                ShiftRotationItem[]
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now()) @updatedAt
  EmployeeShiftSetting EmployeeShiftSetting[]
}

model ShiftRotationItem {
  id        Int                  @id @default(autoincrement())
  patternId Int
  dayIndex  Int // 0..cycleDays-1
  shiftId   Int
  pattern   ShiftRotationPattern @relation(fields: [patternId], references: [id])
  shift     ShiftTemplate        @relation(fields: [shiftId], references: [id])

  @@unique([patternId, dayIndex])
}

model EmployeeShiftSetting {
  id                Int                   @id @default(autoincrement())
  employeeId        Int                   @unique
  mode              ShiftAssignMode       @default(FIXED)
  fixedShiftId      Int?
  rotationPatternId Int?
  startDate         DateTime              @default(now())
  employee          Employee              @relation(fields: [employeeId], references: [id])
  fixedShift        ShiftTemplate?        @relation(fields: [fixedShiftId], references: [id])
  rotationPattern   ShiftRotationPattern? @relation(fields: [rotationPatternId], references: [id])
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
}

// ----------------------
// RESIGNATIONS
// ----------------------
enum ResignationStatus {
  SUBMITTED // created by employee
  UNDER_REVIEW // manager or HR reviewing
  ON_HOLD
  APPROVED // fully approved (HR)
  REJECTED // rejected (manager or HR)
  WITHDRAWN // withdrawn by employee (before approval)
  WITHDRAW_REQUESTED
  CANCELLED // cancelled by HR (process stopped)
  COMPLETED // exit done, F&F closed
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum ClearanceType {
  IT
  FINANCE
  HR
  ADMIN
  SECURITY
  OTHER
}

enum SettlementStatus {
  DUE
  PROCESSING
  PAID
}

model ResignationRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])

  managerId              Int? // captured at creation time (employee.reportingManager)
  reason                 String
  additionalNotes        String?
  noticePeriodDays       Int       @default(30)
  proposedLastWorkingDay DateTime
  actualLastWorkingDay   DateTime?

  status ResignationStatus @default(SUBMITTED)

  withdrawnAt     DateTime?
  withdrawnReason String?

  withdrawRequestedAt     DateTime?
  withdrawDecision        ApprovalDecision? // HR approves or rejects
  withdrawDecidedAt       DateTime?
  withdrawStatusChangedBy Int?

  // Manager gate
  managerDecision  ApprovalDecision @default(PENDING)
  managerDecidedAt DateTime?
  managerNote      String?

  // HR gate
  hrDecision  ApprovalDecision @default(PENDING)
  hrDecidedAt DateTime?
  hrNote      String?

  // Collections
  handoverTasks   ResignationHandoverTask[]
  clearances      ResignationClearance[]
  documents       ResignationDocument?
  exitInterview   ExitInterview?
  finalSettlement FinalSettlement?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([employeeId])
  @@index([managerId])
  @@index([status])
}

model ResignationHandoverTask {
  id            Int        @id @default(autoincrement())
  resignationId Int
  title         String
  description   String?
  assigneeId    Int? // optional delegate
  dueDate       DateTime?
  status        TaskStatus @default(OPEN)
  completedAt   DateTime?

  resignation ResignationRequest @relation(fields: [resignationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resignationId])
  @@index([assigneeId])
  @@index([status])
}

model ResignationClearance {
  id            Int              @id @default(autoincrement())
  resignationId Int
  type          ClearanceType
  decision      ApprovalDecision @default(PENDING)
  verifierId    Int?
  note          String?
  decidedAt     DateTime?

  resignation ResignationRequest @relation(fields: [resignationId], references: [id])
  verifier    Employee?          @relation(fields: [verifierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([resignationId, type]) // one record per type
  @@index([resignationId])
}

model ResignationDocument {
  id                       Int       @id @default(autoincrement())
  resignationId            Int       @unique
  relievingLetterUrl       String?
  experienceLetterUrl      String?
  otherUrl                 String?
  clearanceCertificateUrl  String?
  clearanceCertificateCode String?   @unique
  clearanceIssuedAt        DateTime?

  resignation ResignationRequest @relation(fields: [resignationId], references: [id])
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
}

model ExitInterview {
  id            Int       @id @default(autoincrement())
  resignationId Int       @unique
  scheduledAt   DateTime?
  interviewerId Int?
  notes         String?
  outcome       String?
  completedAt   DateTime?
  employeeId    Int?

  nextOrgName     String?
  nextOrgPosition String?
  nextOrgCategory String? // Govt/Public/Private
  nextOrgLocation String? // India/Abroad
  nextOrgIndustry String? // Hospital/Manufacturing/Others

  // SECTION C: Academic Qualification
  academicQualification String? // JSON string

  // SECTION D: Vacancy Source
  vacancySource String? // JSON string

  // SECTION E: Recruitment Mode
  recruitmentMode String? // JSON string

  // SECTION F: Reasons for Leaving
  reasonForLeaving String?
  triggerReason    String?
  mostSatisfying   String?
  leastSatisfying  String?
  supportReceived  String?
  newJobOffers     String?

  // SECTION G: Expectations & Skills
  expectationsMet  String?
  skillUtilization String?

  // SECTION H: Influencing Factors
  influencedFactors String? // JSON string

  // SECTION I: Dissatisfaction Factors
  dissatisfaction String? // JSON string

  // SECTION J: Job/Dept Opinions
  jobOpinion String? // JSON string

  // SECTION K: Attitude of Superiors
  attitudeSuperiors String? // JSON string

  // SECTION L: Opinion on Company
  companyOpinion String? // JSON string

  // SECTION M: Pay in New Job
  newJobSalaryComparison String? // More / Same / Less

  // SECTION N: Discrimination
  discrimination Boolean?

  // SECTION O: Open-ended
  likedMost         String?
  stayEncouragement String?
  recommendCompany  Boolean?
  recommendReason   String?

  demotivating String? // JSON string (unionism, leadership, etc.)

  employee    Employee?          @relation(fields: [employeeId], references: [id])
  resignation ResignationRequest @relation(fields: [resignationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model FinalSettlement {
  id            Int              @id @default(autoincrement())
  resignationId Int              @unique
  status        SettlementStatus @default(DUE)
  note          String?

  resignation ResignationRequest @relation(fields: [resignationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum JobStatus {
  OPEN
  ON_HOLD
  CLOSED
  DRAFT
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFERED
  OFFER_ACCEPTED
  OFFER_DECLINED
  REJECTED
  WITHDRAWN
  HIRED
  NO_SHOW
}

enum RejectReason {
  SALARY
  ROLE_MISMATCH
  LOCATION
  EXPERIENCE
  CULTURE
  OTHER
}

enum OfferStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  DECLINED
  WITHDRAWN
  EXPIRED
}

enum JoinOutcome {
  JOINED
  NO_SHOW
  DEFERRED
}

model Job {
  id                    Int       @id @default(autoincrement())
  title                 String
  departmentId          Int
  location              String?
  headcount             Int       @default(1)
  status                JobStatus @default(OPEN)
  createdBy             Int
  backfillForEmployeeId Int? // link the vacancy to the exiting employee (optional)

  // timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  department          Department           @relation(fields: [departmentId], references: [id])
  applications        Application[]
  ManpowerRequisition ManpowerRequisition?

  @@index([status])
  @@index([departmentId])
  @@index([title])
}

model Candidate {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  phone         String?
  source        String? // Referral, LinkedIn, Agency, etc.
  resumeUrl     String?
  address       String?
  passwordHash  String?
  lastLogin     DateTime?
  qualification String?
  experience    String?

  loginHistory CandidateLoginHistory[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @default(now()) @updatedAt

  applications Application[]

  @@index([name])
  @@index([source])
  @@index([email])
}

model CandidateLoginHistory {
  id          Int      @id @default(autoincrement())
  candidateId Int
  attemptedAt DateTime @default(now())
  ipAddress   String?
  userAgent   String?
  success     Boolean

  candidate Candidate @relation(fields: [candidateId], references: [id])
}

model Application {
  id            Int               @id @default(autoincrement())
  jobId         Int
  candidateId   Int
  status        ApplicationStatus @default(APPLIED)
  currentStage  String? // e.g., "Tech Round 1"
  rejectReason  RejectReason?
  shortlistNote String?

  expectedCtc   Float?
  noticeDays    Int?
  salaryNote    String?
  source        String? // Referral, LinkedIn, Agency, etc.
  qualification String?
  experience    String? // e.g., "5 years in Java development"

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  job                   Job                     @relation(fields: [jobId], references: [id])
  candidate             Candidate               @relation(fields: [candidateId], references: [id])
  interviews            Interview[]
  offer                 Offer?
  CandidateAssignedTest CandidateAssignedTest[]

  @@index([jobId, status])
  @@index([candidateId])
  @@index([updatedAt])
  @@index([status])
  @@index([jobId])
}

model Interview {
  id                      Int                    @id @default(autoincrement())
  applicationId           Int
  stage                   String // Screen / Tech1 / Panel / HR
  startTime               DateTime
  endTime                 DateTime
  panelUserIds            String? // CSV for simplicity; switch to join table if needed
  feedbackUrl             String?
  feedbackDue             DateTime?
  feedbackAt              DateTime?
  result                  String? // Pass/Fail/OnHold
  candidateAssignedTestId Int?
  candidateAssignedTest   CandidateAssignedTest? @relation(fields: [candidateAssignedTestId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  application       Application         @relation(fields: [applicationId], references: [id])
  InterviewFeedback InterviewFeedback[]
  InterviewHRReview InterviewHRReview?

  @@index([startTime])
  @@index([applicationId])
  @@index([stage])
  @@index([candidateAssignedTestId])
}

model Offer {
  id             Int          @id @default(autoincrement())
  applicationId  Int          @unique
  status         OfferStatus  @default(DRAFT)
  sentAt         DateTime?
  viewedAt       DateTime?
  signedAt       DateTime?
  declinedAt     DateTime?
  declineReason  String?
  proposedJoinAt DateTime?
  joinOutcome    JoinOutcome?
  noShowReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  application Application @relation(fields: [applicationId], references: [id])

  @@index([status])
  @@index([proposedJoinAt])
  @@index([signedAt])
}

// ======================
// ANNOUNCEMENTS + ACKS
// ======================
model Announcement {
  id           Int     @id @default(autoincrement())
  title        String
  circularCode String? @unique
  body         String
  type         String?

  audience    String? // JSON filter e.g. {"departmentId":[2,3]}
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdBy   Int
  requireAck  Boolean   @default(false)
  isPinned    Boolean   @default(false)
  attachments String? // JSON string: '[{ "name": "...", "url": "..." }]'

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  acks AnnouncementAck[]
}

model AnnouncementAck {
  id             Int      @id @default(autoincrement())
  announcementId Int
  employeeId     Int
  acknowledgedAt DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
}

// ======================
// OPTIONAL: INTERNSHIP
// ======================
enum InternshipStatus {
  DRAFT
  OFFERED
  ACTIVE
  COMPLETED
  CONVERTED
  DROPPED
}

model Internship {
  id                  Int              @id @default(autoincrement())
  employeeId          Int?
  mentorId            Int?
  startDate           DateTime
  endDate             DateTime?
  status              InternshipStatus @default(ACTIVE)
  notes               String?
  // ...existing fields...
  certificateCode     String?          @unique
  certificateIssuedAt DateTime?

  candidateName String
  email         String?
  phone         String?
  title         String? // role/track name
  stipend       Int?

  departmentId Int?
  Department   Department? @relation(fields: [departmentId], references: [id])

  employee Employee? @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([mentorId])
  @@index([departmentId])
}

model CandidateAssignedTest {
  id             Int       @id @default(autoincrement())
  applicationId  Int
  candidateId    Int
  testId         Int
  assignedBy     Int
  assignedAt     DateTime  @default(now())
  testDate       DateTime?
  deadlineDate   DateTime?
  status         String    @default("NotStarted") // NotStarted/InProgress/Completed/Cancelled
  attempts       Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  score          Float?
  response       String?
  reviewedBy     Int?
  reviewedAt     DateTime?
  reviewDecision String? // 'PASS' | 'FAIL'
  reviewNote     String?

  application Application    @relation(fields: [applicationId], references: [id])
  test        EvaluationTest @relation(fields: [testId], references: [id])
  Interview   Interview[]

  @@index([applicationId])
  @@index([testId])
  @@index([status])
}

enum InterviewFeedbackStatus {
  DRAFT
  SUBMITTED
}

model InterviewFeedback {
  id            Int     @id @default(autoincrement())
  interviewId   Int
  panelUserId   Int // who filled this
  name          String
  designation   String?
  // scores 0–10
  jobSkills     Int?
  jobKnowledge  Int?
  attitude      Int?
  communication Int?
  average       Float?
  notes         String?
  signature     String?

  status      InterviewFeedbackStatus @default(DRAFT)
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id])

  @@unique([interviewId, panelUserId]) // one feedback per panelist per interview
  @@index([interviewId])
  @@index([panelUserId])
  @@index([status])
}

model InterviewHRReview {
  id             Int      @id @default(autoincrement())
  interviewId    Int      @unique
  // HR-only fields (tweak names as you like)
  presentSalary  Int?
  payslip        Boolean?
  expectedSalary Int?
  grossOffer     Int?
  conclusion     String? // Selected/Shortlisted/Hold/Rejected
  remarks        String?

  reviewerUserId Int?
  reviewedAt     DateTime?

  expectedDoj  DateTime? // expected joining date
  noticePeriod Int? // in days

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  interview Interview @relation(fields: [interviewId], references: [id])

  @@index([reviewerUserId])
}

model OvertimeApproval {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  date         DateTime // the day the OT was worked
  minutes      Int
  scheduledEnd DateTime? // original shift end time
  checkOut     DateTime?
  status       String // PENDING | APPROVED | REJECTED
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  employee     Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date], name: "employeeId_date")
}

model EmployeeSurvey {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  date        DateTime
  createdAt   DateTime  @default(now())
  submittedAt DateTime?
  status      String    @default("DRAFT") // DRAFT | SUBMITTED

  employee  Employee         @relation(fields: [employeeId], references: [id])
  responses SurveyResponse[]
}

model SurveyQuestion {
  id           Int              @id @default(autoincrement())
  section      String
  questionText String
  orderNo      Int
  responses    SurveyResponse[]
}

model SurveyResponse {
  id         Int    @id @default(autoincrement())
  surveyId   Int
  questionId Int
  answer     String

  survey   EmployeeSurvey @relation(fields: [surveyId], references: [id])
  question SurveyQuestion @relation(fields: [questionId], references: [id])
}

enum EvaluationPeriod {
  MONTH_1
  MONTH_3
  MONTH_6
  YEAR_1
  YEAR_2
}

model PerformanceFormTemplate {
  id           Int                   @id @default(autoincrement())
  departmentId Int
  cycle        String // e.g., "APR-2024 TO MAR-2025"
  questions    PerformanceQuestion[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt

  department Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, cycle])
}

model PerformanceQuestion {
  id         Int      @id @default(autoincrement())
  templateId Int
  category   String
  text       String
  orderNo    Int
  weight     Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  template  PerformanceFormTemplate @relation(fields: [templateId], references: [id])
  responses PerformanceResponse[]
}

model PerformanceResponse {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  departmentId Int
  cycle        String
  questionId   Int
  period       EvaluationPeriod
  score        Int? // 1–5
  reviewerId   Int?
  comments     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee   Employee            @relation(fields: [employeeId], references: [id])
  question   PerformanceQuestion @relation(fields: [questionId], references: [id])
  department Department          @relation(fields: [departmentId], references: [id])

  @@index([employeeId])
  @@index([departmentId])
  @@index([cycle])
}

model PerformanceSummary {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  departmentId  Int
  cycle         String
  period        EvaluationPeriod
  marksScored   Int?
  overallPerf   String? // "Outstanding", "Commendable", etc.
  employeeSig   String?          @db.Text
  supervisorSig String?          @db.Text
  hodSig        String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([employeeId, cycle])
  @@index([departmentId])
}

model PerformanceFinalReview {
  id              Int     @id @default(autoincrement())
  employeeId      Int
  departmentId    Int
  cycle           String
  appreciations   String?
  talents         String?
  overallComments String?

  employeeSig   String? @db.Text
  supervisorSig String? @db.Text
  hrSig         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee   Employee   @relation(fields: [employeeId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
}

model ManpowerRequisition {
  id            Int      @id @default(autoincrement())
  jobId         Int?     @unique
  requestDate   DateTime
  designation   String?
  departmentId  Int?
  reasonType    String
  title         String?
  reasonDetails String?
  vacancies     Int?
  minExperience Int?
  maxExperience Int?
  skills        String?
  education     String?
  training      String?

  reasonBreakdown Json?

  // Education preferences
  eduSSC         Boolean?
  eduDiploma     Boolean?
  eduBachelor    Boolean?
  eduMaster      Boolean?
  eduOther       String?
  eduOtherDetail Boolean?

  eduSSCDetail      String?
  eduDiplomaDetail  String?
  eduBachelorDetail String?
  eduMasterDetail   String?

  urgent      Boolean? @default(false)
  duration    String?
  reportingTo String?

  // Approvals - Raised By
  raisedBy         String?
  raisedBySign     String?   @db.LongText
  raisedByDate     DateTime?
  raisedByComments String?

  // Approvals - HoD
  approvedByHoD         String?
  hodSign               String?   @db.LongText
  approvedByHoDDate     DateTime?
  approvedByHoDComments String?

  // Approvals - SMO
  approvedBySMO         String?
  smoSign               String?   @db.LongText
  approvedBySMODate     DateTime?
  approvedBySMOComments String?

  // Approvals - HR
  receivedByHR         String?
  hrSign               String?   @db.LongText
  receivedByHRDate     DateTime?
  receivedByHRComments String?

  // HR Use Only
  hrReferenceNo String?
  salaryRange   String?
  source        String?
  actionTaken   String?
  closedOn      DateTime?
  hrRemarks     String?

  // Status (workflow step)
  status String @default("RAISED")
  // possible values: PENDING, RAISED, HOD_APPROVED, SMO_APPROVED, HR_RECEIVED, CLOSED, REJECTED

  // Rejections
  hodRejectedBy       String?
  hodRejectedDate     DateTime?
  hodRejectedComments String?

  smoRejectedBy       String?
  smoRejectedDate     DateTime?
  smoRejectedComments String?

  hrRejectedBy       String?
  hrRejectedDate     DateTime?
  hrRejectedComments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  job Job? @relation(fields: [jobId], references: [id])
}

enum GrievanceStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED
}

model Grievance {
  id          Int             @id @default(autoincrement())
  employeeId  Int
  title       String
  description String
  category    String? // e.g., "Workplace Issue", "Salary", "Harassment", "Other"
  status      GrievanceStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee                 Employee                   @relation(fields: [employeeId], references: [id])
  comments                 GrievanceComment[]
  ComplaintAcknowledgement ComplaintAcknowledgement[]

  @@index([status])
}

model GrievanceComment {
  id          Int    @id @default(autoincrement())
  grievanceId Int
  employeeId  Int
  comment     String

  createdAt DateTime  @default(now())
  grievance Grievance @relation(fields: [grievanceId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])
}

enum PoshStatus {
  FILED
  UNDER_INVESTIGATION
  CLOSED
  REJECTED
}

model PoshCase {
  id            Int        @id @default(autoincrement())
  complainantId Int // Employee who raised it
  accusedId     Int // Employee against whom complaint is raised
  description   String
  status        PoshStatus @default(FILED)
  committeeNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  complainant              Employee                   @relation("ComplainantCases", fields: [complainantId], references: [id])
  accused                  Employee                   @relation("AccusedCases", fields: [accusedId], references: [id])
  hearings                 PoshHearing[]
  ComplaintAcknowledgement ComplaintAcknowledgement[]

  @@index([status])
}

model PoshHearing {
  id       Int      @id @default(autoincrement())
  poshId   Int
  date     DateTime
  notes    String?
  outcome  String?
  poshCase PoshCase @relation(fields: [poshId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ======================
// TRAINING MODULE
// ======================

enum TrainingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

model Training {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  objectives  String? @db.Text

  // Trainer details
  trainerType String? // INTERNAL | EXTERNAL
  trainerId   Int? // for internal trainers (Employee)
  trainerName String? // for external trainers
  trainerOrg  String? // optional: external trainer organization

  trainers Json?

  mode          String? // ONLINE | OFFLINE | HYBRID
  location      String?
  startDate     DateTime?
  endDate       DateTime?
  status        TrainingStatus @default(DRAFT)
  durationHours Float?
  departmentId  Int?
  createdBy     Int

  department        Department?          @relation(fields: [departmentId], references: [id])
  trainer           Employee?            @relation(fields: [trainerId], references: [id])
  assignedEmployees TrainingAssignment[]
  trainingTests     TrainingTest[]
  feedbacks         TrainingFeedback[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  TrainingAttendance TrainingAttendance[]

  @@index([status])
  @@index([departmentId])
  @@index([trainerId])
}

model TrainingTest {
  id           Int            @id @default(autoincrement())
  trainingId   Int
  testId       Int
  isMandatory  Boolean        @default(true)
  orderNo      Int?
  testDate     DateTime?
  deadlineDate DateTime?
  training     Training       @relation(fields: [trainingId], references: [id])
  test         EvaluationTest @relation(fields: [testId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([trainingId, testId])
}

model TrainingAssignment {
  id          Int       @id @default(autoincrement())
  trainingId  Int
  employeeId  Int
  assignedBy  Int
  assignedAt  DateTime  @default(now())
  status      String    @default("NotStarted") // NotStarted/InProgress/Completed
  progress    Float?
  completedAt DateTime?

  training      Training       @relation(fields: [trainingId], references: [id])
  employee      Employee       @relation(fields: [employeeId], references: [id])
  assignedTests AssignedTest[] // tests given as part of this training

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([trainingId, employeeId])
  @@index([status])
}

model TrainingFeedback {
  id             Int     @id @default(autoincrement())
  trainingId     Int
  employeeId     Int
  rating         Int? // overall training rating 1–5
  feedback       String? // comments
  trainerRating  Int? // trainer quality rating
  contentQuality Int? // material rating
  relevance      Int? // relevance rating
  suggestions    String? // improvement suggestions

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  training Training @relation(fields: [trainingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([trainingId, employeeId])
  @@index([trainingId])
}

model ComplaintAcknowledgement {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  grievanceId    Int?
  poshCaseId     Int?
  acknowledgedAt DateTime @default(now())

  employee  Employee   @relation(fields: [employeeId], references: [id])
  grievance Grievance? @relation(fields: [grievanceId], references: [id])
  poshCase  PoshCase?  @relation(fields: [poshCaseId], references: [id])
  createdAt DateTime   @default(now())

  @@index([employeeId])
  @@index([grievanceId])
  @@index([poshCaseId])
}

enum BalanceCategory {
  LEAVE
  PERMISSION
}

model EmployeeLeaveBalance {
  id             Int             @id @default(autoincrement())
  employeeId     Int
  leaveTypeId    Int?
  permissionType PermissionType?
  category       BalanceCategory // LEAVE or PERMISSION
  year           Int
  totalAllowed   Int             @default(0)
  used           Int             @default(0)

  employee  Employee   @relation(fields: [employeeId], references: [id])
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, permissionType, year])
}

model TrainingAttendance {
  id         Int       @id @default(autoincrement())
  trainingId Int
  employeeId Int
  date       DateTime // Which day they attended
  status     String // PRESENT | ABSENT | LATE
  markedAt   DateTime? // When attendance was marked
  markedBy   Int? // Employee/User ID who marked

  training Training @relation(fields: [trainingId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([trainingId, employeeId, date]) // one record per person per day
  @@index([trainingId])
  @@index([employeeId])
}

model Incident {
  id          Int      @id @default(autoincrement())
  employeeId  Int // employee involved
  reportedBy  Int // who raised it
  title       String
  description String   @db.Text
  status      String
  attachment  String? // file URL (optional)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  employee Employee @relation("IncidentEmployee", fields: [employeeId], references: [id])
  reporter Employee @relation("IncidentReporter", fields: [reportedBy], references: [id])
}
