model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  basic            Float    @default(0)
  hra              Float    @default(0)
  medicalAllowance Float    @default(0)
  travelAllowance  Float    @default(0)
  specialAllowance Float    @default(0)
  otherAllowances  Float    @default(0)
  // Fixed monthly components paid in full (not prorated for LOP) — feed the
  // payroll working-sheet CTC. Monthly CTC = full-month gross + PF employer +
  // lta + mobileInternet + mealFuel.
  lta              Float    @default(0)
  mobileInternet   Float    @default(0)
  mealFuel         Float    @default(0)
  pfApplicable     Boolean  @default(true)
  esiApplicable    Boolean  @default(true)
  ptApplicable     Boolean  @default(true)
  tdsMonthly       Float    @default(0)
  effectiveFrom    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  employee         Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Bank account for salary credit — 1:1 with an employee. Populated from the
// payroll working sheet's BANK DETAILS block (or the employee profile).
model EmployeeBankDetail {
  id                Int      @id @default(autoincrement())
  employeeId        Int      @unique
  bankAccountNumber String?
  ifscCode          String?
  nameOnAccount     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  employee          Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// Salary revision history — one row per CTC change, so increment %
// (management dashboard #22) can be computed. Written by
// upsertSalaryStructure whenever the monthly CTC actually changes.
model SalaryRevision {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  previousCtc   Float
  newCtc        Float
  percentage    Float
  effectiveFrom DateTime @default(now())
  reason        String?
  createdBy     Int?
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([effectiveFrom])
}

model PayrollRun {
  id          Int               @id @default(autoincrement())
  companyId   Int?
  month       Int
  year        Int
  status      String            @default("DRAFT")
  notes       String?
  processedBy Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  payslips    Payslip[]
  dispatches  PayrollDispatch[]
  company     Company?          @relation(fields: [companyId], references: [id])

  // Month-end freeze. Once locked the run cannot be deleted, re-imported or
  // recomputed — the figures are what was actually paid. Unlocking is a
  // deliberate, audited act rather than an implicit side effect of an edit.
  lockedAt DateTime?
  lockedBy Int?

  // One run per company per month. companyId is nullable for legacy rows only —
  // createPayrollRun always resolves a company, and the bootstrap backfills
  // existing rows to the default company so the constraint stays meaningful
  // (MySQL treats NULLs as distinct in unique indexes).
  @@unique([companyId, month, year])
  @@index([status])
  @@index([companyId])
}

model Payslip {
  id               Int   @id @default(autoincrement())
  employeeId       Int
  payrollRunId     Int
  month            Int
  year             Int
  workingDays      Int   @default(0)
  presentDays      Float @default(0)
  leaveDays        Float @default(0)
  lopDays          Float @default(0)
  overtimeHours    Float @default(0)
  overtimePay      Float @default(0)
  basic            Float @default(0)
  hra              Float @default(0)
  medicalAllowance Float @default(0)
  travelAllowance  Float @default(0)
  specialAllowance Float @default(0)
  otherAllowances  Float @default(0)
  grossEarnings    Float @default(0)
  pfEmployee       Float @default(0)
  pfEmployer       Float @default(0)
  esiEmployee      Float @default(0)
  esiEmployer      Float @default(0)
  professionalTax  Float @default(0)
  tds              Float @default(0)

  // ── Statutory additions (Phase 1) ──────────────────────────────────────────
  // LWF is a deduction (employee half) plus an employer contribution. Both are
  // zero in months the state doesn't collect — see StatutoryConfig.lwfFrequency.
  lwfEmployee          Float @default(0)
  lwfEmployer          Float @default(0)
  // PF side-charges the employer pays on top of its 12% share.
  pfAdminCharges       Float @default(0)
  edliCharges          Float @default(0)
  // Employer-cost provisions. NOT deductions and NOT part of netPay — they are
  // accrued monthly so the JV/CTC reports and the gratuity liability are right.
  gratuityProvision    Float @default(0)
  bonusProvision       Float @default(0)
  leaveEncashProvision Float @default(0)
  // How `tds` above was arrived at: AUTO = projected by the tax engine,
  // MANUAL = SalaryStructure.tdsMonthly / HR override. Kept so a payslip can be
  // explained months later without re-running the projection.
  // Auto-pulled from the loan and incentive modules when the run is created.
  // Kept as their own columns rather than folded into otherDeduction /
  // otherAddition so the payslip explains where the money went.
  loanRecovery         Float @default(0)
  incentivePayout      Float @default(0)

  tdsMode              String     @default("MANUAL")
  taxRegime            String? // OLD | NEW — regime in force for this payslip
  // Working-sheet input columns (HR/Finance). Additions and reimbursements add
  // to net pay; advanceRecovery/otherDeduction add to total deductions. lopDays
  // above becomes HR-overridable via the working-sheet import.
  variableIncentive    Float      @default(0)
  salaryRevisionArrear Float      @default(0)
  otherAddition        Float      @default(0)
  petrolReimb          Float      @default(0)
  driverReimb          Float      @default(0)
  advanceRecovery      Float      @default(0)
  otherDeduction       Float      @default(0)
  totalDeductions      Float      @default(0)
  netPay               Float      @default(0)
  remarks              String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @default(now()) @updatedAt
  employee             Employee   @relation(fields: [employeeId], references: [id])
  payrollRun           PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([employeeId, payrollRunId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@index([year, month])
}

model AttendancePunch {
  id           Int      @id @default(autoincrement())
