model MobileAuthSession {
  id            String   @id @default(uuid())
  employeeId    Int
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  identityOk    Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

/// Server-side session records. Two producers, one table:
///   • mobile  — stores the RAW opaque token (legacy, /api/auth/mobile/refresh)
///   • web     — stores the SHA-256 HASH of the token that lives in the
///               httpOnly `hr_rt` cookie, so a DB leak can't mint sessions.
/// The two never collide (a 64-char hex hash can't equal a UUID), so lookups
/// stay unambiguous without a discriminator column.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AttendanceNotificationLog {
  id        Int      @id @default(autoincrement())
  uniqueKey String   @unique
  date      DateTime
  shiftId   Int
  runAt     DateTime
  lateCount Int
  createdAt DateTime @default(now())
}

model HolidayCalendar {
  id        Int       @id @default(autoincrement())
  year      Int       @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  holidays  Holiday[]
}

model Holiday {
  id          Int             @id @default(autoincrement())
  calendarId  Int
  title       String
  date        DateTime
  description String?
  isOptional  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  /// Null = org-wide holiday, shown to every branch. Set = applies only to
  /// that branch (regional holidays), layered on top of the org-wide list.
  branchId    Int?
  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id])
  branch      Branch?         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // MySQL treats NULLs as distinct in a unique index (same tradeoff as
  // EmployeeDataScope): this dedupes per-branch holidays on the same date,
  // but doesn't stop two org-wide (branchId null) rows landing on the same
  // date — that's still prevented at the controller level.
  @@unique([calendarId, date, branchId])
  @@index([date])
  @@index([branchId])
}

model ShiftApproval {
  id                  Int                   @id @default(autoincrement())
  employeeId          Int
  rmDecision          ApprovalDecision      @default(PENDING)
  rmDecidedAt         DateTime?
  hrDecision          ApprovalDecision      @default(PENDING)
  hrDecidedAt         DateTime?
  status              ApprovalDecision      @default(PENDING)
  fixedShiftId        Int?
  hasIncharge         Boolean
  patternId           Int?
  month               Int?
  year                Int?
  isMonthly           Boolean?              @default(false)
  weekOffConfig       Json?
  requestedAt         DateTime              @default(now())
  requestedBy         Int
  requestedMode       ShiftAssignMode
  startDate           DateTime
  appliedAt           DateTime?
  hrRejectReason      String?               @db.Text
  rmRejectReason      String?               @db.Text
  // Post-approval edit workflow: once fully APPROVED, the creator asks HR for
  // permission to edit; HR approves; the creator may then edit UPCOMING weeks,
  // which re-enters the RM → HR approval chain.
  editStatus          ShiftEditStatus       @default(NONE)
  editRequestedBy     Int?
  editRequestedAt     DateTime?
  editReason          String?               @db.Text
  editDecidedBy       Int?
  editDecidedAt       DateTime?
  editRejectReason    String?               @db.Text
  employee            Employee              @relation(fields: [employeeId], references: [id])
  fixedShift          ShiftTemplate?        @relation(fields: [fixedShiftId], references: [id])
  pattern             ShiftRotationPattern? @relation(fields: [patternId], references: [id])
  requestedByEmployee Employee              @relation("ShiftApprovalRequestedBy", fields: [requestedBy], references: [id])

  @@index([employeeId])
  @@index([fixedShiftId])
  @@index([patternId])
  @@index([requestedBy])
}

enum ShiftEditStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
}

// HR "month closed" lock — one row per month/year locks shift edits org-wide.
model ShiftMonthLock {
