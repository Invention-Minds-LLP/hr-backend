// ─── Payroll ────────────────────────────────────────────────────────────────

model SalaryStructure {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @unique
  basic            Float    @default(0)
  hra              Float    @default(0)
  medicalAllowance Float    @default(0)
  travelAllowance  Float    @default(0)
  specialAllowance Float    @default(0)
  otherAllowances  Float    @default(0)
  pfApplicable     Boolean  @default(true)
  esiApplicable    Boolean  @default(true)
  ptApplicable     Boolean  @default(true)
  tdsMonthly       Float    @default(0)
  effectiveFrom    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  employee         Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model PayrollRun {
  id          Int       @id @default(autoincrement())
  month       Int
  year        Int
  status      String    @default("DRAFT")
  notes       String?
  processedBy Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  payslips    Payslip[]

  @@unique([month, year])
  @@index([status])
}

model Payslip {
  id               Int        @id @default(autoincrement())
  employeeId       Int
  payrollRunId     Int
  month            Int
  year             Int
  workingDays      Int        @default(0)
  presentDays      Float      @default(0)
  leaveDays        Float      @default(0)
  lopDays          Float      @default(0)
  overtimeHours    Float      @default(0)
  overtimePay      Float      @default(0)
  basic            Float      @default(0)
  hra              Float      @default(0)
  medicalAllowance Float      @default(0)
  travelAllowance  Float      @default(0)
  specialAllowance Float      @default(0)
  otherAllowances  Float      @default(0)
  grossEarnings    Float      @default(0)
  pfEmployee       Float      @default(0)
  pfEmployer       Float      @default(0)
  esiEmployee      Float      @default(0)
  esiEmployer      Float      @default(0)
  professionalTax  Float      @default(0)
  tds              Float      @default(0)
  totalDeductions  Float      @default(0)
  netPay           Float      @default(0)
  remarks          String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  employee         Employee   @relation(fields: [employeeId], references: [id])
  payrollRun       PayrollRun @relation(fields: [payrollRunId], references: [id])

  @@unique([employeeId, payrollRunId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@index([year, month])
}

model AttendancePunch {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  type         String // CHECK_IN, CHECK_OUT
  activityType String // OFFICE, CLIENT_VISIT, FIELD_WORK
  timestamp    DateTime @default(now())
  latitude     Float
  longitude    Float
  address      String?
  photoUrl     String?  @db.Text
  notes        String?
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, timestamp])
  @@index([employeeId])
}

model WeeklyPerformanceReport {
  id              Int                @id @default(autoincrement())
  employeeId      Int
  weekStartDate   DateTime
  weekEndDate     DateTime
  weekLabel       String?
  status          WeeklyReportStatus @default(DRAFT)
  employeeSummary String?            @db.Text

  inChargeDecision  ApprovalDecision @default(PENDING)
  inChargeDecidedAt DateTime?
  inChargeNote      String?          @db.Text
  inChargeRating    Int?

  hodDecision  ApprovalDecision @default(PENDING)
  hodDecidedAt DateTime?
  hodNote      String?          @db.Text
  hodRating    Int?

  hrDecision  ApprovalDecision @default(PENDING)
  hrDecidedAt DateTime?
  hrNote      String?          @db.Text
  hrRating    Int?

  approvedBy    Int?
  approvedDate  DateTime?
  declinedBy    Int?
  declinedDate  DateTime?
  declineReason String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  previousWeekId Int?

  employee   Employee          @relation(fields: [employeeId], references: [id])
  dailyTasks WeeklyTaskEntry[]

  @@unique([employeeId, weekStartDate])
  @@index([employeeId])
  @@index([weekStartDate])
  @@index([status])
}

model WeeklyTaskEntry {
  id                 Int             @id @default(autoincrement())
  reportId           Int
  taskDate           DateTime
  taskDescription    String          @db.Text
  category           String?
  priority           TaskPriority    @default(MEDIUM)
  taskStatus         DailyTaskStatus @default(NOT_STARTED)
  percentComplete    Int             @default(0)
  assignedById       Int?
  deadline           DateTime?
  completionDate     DateTime?
  remarks            String?         @db.Text
  isCarriedForward   Boolean         @default(false)
  carriedFromEntryId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  report WeeklyPerformanceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([taskDate])
  @@index([assignedById])
}

model WeeklyRatingQuestion {
  id            Int      @id @default(autoincrement())
  text          String
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  designationId Int?
  createdBy     Int?
  createdAt     DateTime @default(now())

  designation Designation?         @relation(fields: [designationId], references: [id])
  answers     WeeklyRatingAnswer[]

  @@index([designationId])
}

model WeeklyPerformanceRating {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  ratedBy        Int
  weekStartDate  DateTime
  weekEndDate    DateTime
  weekLabel      String?
  overallScore   Float?
  managerRemarks String?  @db.Text
  status         String   @default("DRAFT") // DRAFT, SUBMITTED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  employee Employee             @relation("WeeklyRatingEmployee", fields: [employeeId], references: [id])
  answers  WeeklyRatingAnswer[]

  @@unique([employeeId, weekStartDate])
  @@index([employeeId])
  @@index([ratedBy])
  @@index([weekStartDate])
  @@index([status])
}

model WeeklyRatingAnswer {
  id         Int     @id @default(autoincrement())
  ratingId   Int
  questionId Int
  score      Int // 1-10
  remarks    String?

  rating   WeeklyPerformanceRating @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  question WeeklyRatingQuestion    @relation(fields: [questionId], references: [id])

  @@unique([ratingId, questionId])
  @@index([ratingId])
  @@index([questionId])
}

model Incentive {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  type          String // BONUS, PERFORMANCE, FESTIVAL, REFERRAL, OTHER
  amount        Float
  description   String?   @db.Text
  effectiveDate DateTime
  paidOn        DateTime?
  status        String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED, REJECTED
  requestedBy   Int? // manager who requested
  approvedBy    Int?
  approvedAt    DateTime?
  rejectedBy    Int?
  rejectedAt    DateTime?
  rejectReason  String?
  source        String    @default("MANUAL") // MANUAL (HR), REQUEST (Manager)
  remarks       String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([requestedBy])
}

model Loan {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  loanType           String // SALARY_ADVANCE, PERSONAL, EMERGENCY, OTHER
  principalAmount    Float
  interestRate       Float     @default(0)
  tenure             Int // months
  emiAmount          Float
  totalRepaid        Float     @default(0)
  outstandingBalance Float
  status             String    @default("PENDING") // PENDING, APPROVED, ACTIVE, CLOSED, REJECTED
  appliedOn          DateTime  @default(now())
  approvedBy         Int?
  approvedAt         DateTime?
  disbursedOn        DateTime?
  reason             String?   @db.Text
  remarks            String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  employee   Employee        @relation(fields: [employeeId], references: [id])
  repayments LoanRepayment[]

  @@index([employeeId])
  @@index([status])
}

model LoanRepayment {
  id         Int      @id @default(autoincrement())
  loanId     Int
  employeeId Int
  amount     Float
  paidOn     DateTime
  mode       String? // SALARY_DEDUCTION, CASH, BANK_TRANSFER
  remarks    String?
  createdAt  DateTime @default(now())

  loan     Loan     @relation(fields: [loanId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([loanId])
  @@index([employeeId])
}

// ─── PIP (Performance Improvement Plan) ────────────────────────────────────

enum PIPStatus {
  WARNING_ISSUED
  PIP_ACTIVE
  PIP_EXTENDED
  PIP_CLOSED_IMPROVED
  TERMINATION_INITIATED
  TERMINATED
}

enum PIPTemplateType {
  WARNING
  PIP_INITIATION
  PIP_WEEKLY_REVIEW
  PIP_EXTENSION
  PIP_CLOSURE
  TERMINATION_NOTICE
}

model PIPEmailTemplate {
  id        Int             @id @default(autoincrement())
  name      String
  type      PIPTemplateType
  subject   String
  body      String          @db.LongText
  cc        String?
  bcc       String?
  isActive  Boolean         @default(true)
  createdBy Int?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  logs PIPEmailLog[]
}

model EmployeePIP {
  id               Int       @id @default(autoincrement())
  pipNumber        String?   @unique
  employeeId       Int
  triggerScore     Float
  triggerMonth     String
  status           PIPStatus @default(WARNING_ISSUED)
  targets          Json?
  trainingIds      Json?
  pipStartDate     DateTime?
  pipEndDate       DateTime?
  extendedCount    Int       @default(0)
  warningDate      DateTime?
  responseDeadline DateTime?
  noticePeriodDays Int?
  terminationReason String?  @db.Text
  remarks          String?   @db.Text
  initiatedBy      Int
  closedAt         DateTime?
  closedBy         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee      Employee               @relation(fields: [employeeId], references: [id])
  weeklyReviews PIPWeeklyReview[]
  emailLogs     PIPEmailLog[]
  responses     PIPEmployeeResponse[]

  @@index([employeeId])
  @@index([status])
  @@index([triggerMonth])
}

model PIPWeeklyReview {
  id          Int      @id @default(autoincrement())
  pipId       Int
  weekNumber  Int
  reviewDate  DateTime
  weeklyScore Float?
  status      String
  remarks     String?  @db.Text
  reviewedBy  Int
  createdAt   DateTime @default(now())

  pip EmployeePIP @relation(fields: [pipId], references: [id])

  @@index([pipId])
}

model PIPEmailLog {
  id            Int      @id @default(autoincrement())
  pipId         Int?
  employeeId    Int
  templateId    Int?
  sentTo        String
  subject       String
  body          String   @db.LongText
  sentBy        Int
  sentAt        DateTime @default(now())
  status        String   @default("SENT")
  errorMessage  String?  @db.Text
  responseToken String?  @unique

  pip      EmployeePIP?      @relation(fields: [pipId], references: [id])
  template PIPEmailTemplate? @relation(fields: [templateId], references: [id])
  employee Employee          @relation(fields: [employeeId], references: [id])

  @@index([pipId])
  @@index([employeeId])
  @@index([sentAt])
}

enum PIPResponseMethod {
  EMAIL_LINK
  HR_LOGGED
  EMPLOYEE_SELF
}

model PIPEmployeeResponse {
  id             Int                @id @default(autoincrement())
  pipId          Int
  employeeId     Int
  method         PIPResponseMethod
  responseText   String             @db.Text
  tokenUsed      String?
  respondedAt    DateTime           @default(now())
  acknowledgedBy Int?
  acknowledgedAt DateTime?
  createdAt      DateTime           @default(now())

  pip      EmployeePIP @relation(fields: [pipId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@index([pipId])
  @@index([employeeId])
}
