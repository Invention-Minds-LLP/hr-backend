  EXTERNAL    // referred by an outside individual (friend, ex-colleague)
  AGENCY      // recruitment agency / consultancy
  JOB_BOARD   // Naukri, LinkedIn Jobs, Indeed, etc.
  SOCIAL      // organic social-media application
  WALK_IN
  OTHER
}

// Lifecycle of an internal-referral payout. Most referrals start at
// PENDING_JOIN once the offer is signed, then advance via cron.
enum ReferralBonusStatus {
  NOT_APPLICABLE      // no bonus owed (e.g. EXTERNAL/AGENCY)
  PENDING_JOIN        // waiting for candidate to actually join
  PENDING_PROBATION   // joined; waiting on probation completion (e.g. 90 days)
  ELIGIBLE            // probation cleared; HR can pay
  PAID
  FORFEITED           // candidate left / terminated before probation
}

enum RefCheckStatus {
  PENDING
  IN_PROGRESS
  DONE
  UNREACHABLE
  FLAGGED      // referee gave concerning feedback
}

enum BgvStatus {
  NOT_INITIATED
