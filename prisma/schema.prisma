generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                      Int              @id @default(autoincrement())
  employeeCode            String           @unique
  referenceCode           String?
  firstName               String
  lastName                String
  gender                  Gender
  dob                     DateTime
  photoUrl                String?
  phone                   String
  email                   String
  departmentId            Int
  branchId                Int
  dateOfJoining           DateTime
  employmentType          EmploymentType
  probationStartDate      DateTime?
  probationEndDate        DateTime?
  probationStatus         ProbationStatus?
  probationConfirmedOn    DateTime?
  probationConfirmedBy    Int?
  probationRemarks        String?
  employmentStatus        EmploymentStatus
  roleId                  Int
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @default(now()) @updatedAt
  shiftId                 Int?
  sameAsPermanent         Boolean?
  age                     Int?
  bloodGroup              String?
  reportingManager        Int?
  employeeType            String?
  alcohol                 Boolean?
  allergies               String?
  bloodPressure           String?
  bloodSugar              String?
  bmi                     Float?
  cholesterol             String?
  chronicConditions       String?
  emergencyNotes          String?
  exerciseFrequency       String?
  healthIssues            Json?
  height                  Float?
  preEmploymentCheckDate  DateTime?
  preferredHospital       String?
  primaryPhysician        String?
  smoking                 Boolean?
  vaccinations            Json?
  weight                  Float?
  pastSurgeries           String?
  usesGlasses             Boolean?
  visionRemarks           String?
  visionType              String?
  disabilityDescription   String?
  disabilityProofFile     String?
  disabilityProofFileName String?
  disabilityProofUrl      String?
  disabilityType          String?
  hasDisability           Boolean?
  healthCheckReminderSent Boolean?         @default(false)
  healthCheckReminderYear Int?
  designationId           Int?
  inchargeId              Int?
  experience              Int?
  fatherName              String?
  marital                 String?
  totalYearsOfExperience  Int?
  motherName              String?
  alternatePhone          String?
  uanNumber               String?
  panNumber               String?
  aadharNumber            String?
  licenseNumber           String?
  licenseRegDate          DateTime?
  licenseExpiryDate       DateTime?
  geoTrackingEnabled      Boolean?         @default(false)
  geoTrackingConsent      Boolean?         @default(false)
  geoTrackingConsentAt    DateTime?
  experienceType          String?
  overtimeEnabled         Boolean?         @default(false)

  // Legal entity this employee is payrolled under. Nullable so existing rows
  // survive the rollout; `resolveCompanyId()` falls back to the default company
  // when unset. Payroll, statutory config and Form 16 are all scoped by this —
  // a group running several registered entities keeps their PF/ESI/PT codes,
  // payroll runs and returns separate under one deployment.
  companyId Int?

  // Per-employee attendance channel. NULL = inherit the branch's attendanceMode.
  // Effective mode = attendanceMode ?? Branch.attendanceMode ?? MOBILE.
  attendanceMode AttendanceMode?

  // Access-revocation timestamp. When HR fires/suspends an employee or the
  // resignation cron flips them to RESIGNED, this is set to "now". The auth
  // middleware refuses any JWT whose `iat` is older than this value, so all
  // existing browser sessions die instantly. Independent of `employmentStatus`
  // so we can keep an audit trail of when access was actually killed.
  accessRevokedAt DateTime?

  Address                    Address[]
  AnnouncementAck            AnnouncementAck[]
  appraisals                 AppraisalForm[]
  appraisalPauses            EmployeeAppraisalPause[]
  AssignedTest               AssignedTest[]
  attendances                Attendance[]
  bagChecks                  BagCheck[]
  ComplaintAcknowledgement   ComplaintAcknowledgement[]
  documents                  Document[]
  emergencyContacts          EmergencyContact[]
  Branch                     Branch                      @relation(fields: [branchId], references: [id])
  Department                 Department                  @relation(fields: [departmentId], references: [id])
  designation                Designation?                @relation(fields: [designationId], references: [id])
  incharge                   Employee?                   @relation("EmployeeIncharge", fields: [inchargeId], references: [id])
  subordinates               Employee[]                  @relation("EmployeeIncharge")
  role                       Role                        @relation(fields: [roleId], references: [id])
  permissionOverrides        EmployeePermission[]
  performedLedgers           LeaveLedger[]               @relation("LedgerPerformedBy")
  EmployeeShiftSetting       EmployeeShiftSetting?
  EmployeeSurvey             EmployeeSurvey[]
  evaluations                EvaluationAttempt[]
  ExitInterview              ExitInterview[]
  Grievance                  Grievance[]
  GrievanceComment           GrievanceComment[]
  incidentAsEmployee         Incident[]                  @relation("IncidentEmployee")
  incidentAsReporter         Incident[]                  @relation("IncidentReporter")
  Internship                 Internship[]
  LateLoginLog               LateLoginLog[]
  leaveRequests              LeaveRequest[]
  mobileAuthSessions         MobileAuthSession[]
  OvertimeApproval           OvertimeApproval[]
  PerformanceFinalReview     PerformanceFinalReview[]
  PerformanceResponse        PerformanceResponse[]
  PerformanceSummary         PerformanceSummary[]
  permissions                PermissionRequest[]
  poshAccusations            PoshCase[]                  @relation("AccusedCases")
  poshComplaints             PoshCase[]                  @relation("ComplainantCases")
  qualifications             Qualification[]
  ResignationClearance       ResignationClearance[]
  ResignationRequest         ResignationRequest[]
  shiftApprovals             ShiftApproval[]
  requestedShiftApprovals    ShiftApproval[]             @relation("ShiftApprovalRequestedBy")
  shifts                     ShiftAssignment[]
  Training                   Training[]
  TrainingAssignment         TrainingAssignment[]
  TrainingAttendance         TrainingAttendance[]
  TrainingFeedback           TrainingFeedback[]
  User                       User?
  WFHRequest                 WFHRequest[]
  sabbaticals                Sabbatical[]
  compOffCredits             CompOffCredit[]
  verifiedItems              ResignationClearanceItem[]
  locationSessions           LocationSession[]
  leaveAccruals              LeaveAccrual[]
  leaveLedgers               LeaveLedger[]
  forcePresentActions        ForcePresentAction[]
  punchCorrections           PunchCorrectionLog[]
  leaveBalanceAdjustments    LeaveBalanceAdjustmentLog[]
  attendanceOverrides        AttendanceOverrideLog[]
  weekOffHolidayOverrides    WeekOffHolidayOverrideLog[]
  appraisalOverrides         AppraisalOverrideLog[]
  salaryStructure            SalaryStructure?
  salaryRevisions            SalaryRevision[]
  bankDetail                 EmployeeBankDetail?
  payslips                   Payslip[]
  attendancePunches          AttendancePunch[]
  weeklyPerformanceReports   WeeklyPerformanceReport[]
  weeklyRatings              WeeklyPerformanceRating[]   @relation("WeeklyRatingEmployee")
  incentives                 Incentive[]
  loans                      Loan[]
  loanRepayments             LoanRepayment[]
  pips                       EmployeePIP[]
  pipEmailLogs               PIPEmailLog[]
  pipResponses               PIPEmployeeResponse[]
  probationRecords           ProbationRecord[]
  interviewPanels            InterviewPanelMember[]
  referredApplications       Application[]               @relation("ReferredApplications")
  // Manpower-requisition relations — see ManpowerRequisition for direction details.
  manpowerRequisitionsRaised ManpowerRequisition[]       @relation("ManpowerRaisedBy")
  manpowerRequisitionsHoD    ManpowerRequisition[]       @relation("ManpowerApprovedHoD")
  manpowerRequisitionsSMO    ManpowerRequisition[]       @relation("ManpowerApprovedSMO")
  manpowerRequisitionsHR     ManpowerRequisition[]       @relation("ManpowerReceivedHR")

  // Audit log — every change to this employee's row, plus changes this person made to others.
  auditLogTargets  EmployeeAuditLog[] @relation("EmployeeAuditTarget")
  auditLogAuthored EmployeeAuditLog[] @relation("EmployeeAuditAuthor")

  // Committee memberships (ICC for POSH, Grievance Redressal Committee, etc.)
  committeeMemberships CommitteeMember[]

  // Legal entity + income-tax relations
  company                   Company?                   @relation(fields: [companyId], references: [id])
  taxProfiles               EmployeeTaxProfile[]
  taxDeclarations           TaxDeclaration[]
  form16Records             Form16Record[]
  salaryArrears             SalaryArrear[]
  lettersIssued             LetterIssued[]
  assetAllocations          AssetAllocation[]
  salaryTemplateAssignments SalaryTemplateAssignment[]

  // Row-level data scope. Zero rows = this person sees everyone (the historic
  // behaviour); one or more rows narrows them to those branches/departments.
  dataScopes        EmployeeDataScope[] @relation("DataScopeOwner")
  dataScopesGranted EmployeeDataScope[] @relation("DataScopeGrantedBy")

  @@index([employmentStatus])
  @@index([departmentId])
  @@index([branchId])
  @@index([roleId])
  @@index([companyId])
  @@index([firstName])
  @@index([lastName])
  @@index([reportingManager])
  @@index([inchargeId])
  @@index([designationId], map: "Employee_designationId_fkey")
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  name         String
  phone        String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "EmergencyContact_employeeId_fkey")
}

model Address {
  id         Int      @id @default(autoincrement())
  employeeId Int
  type       String
  line1      String
  line2      String?
  city       String
  state      String
  zipCode    String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Address_employeeId_fkey")
}

model Qualification {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  degree      String
  institution String
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  degreeName  String?
  grade       String?
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Qualification_employeeId_fkey")
}

model Document {
  id         Int       @id @default(autoincrement())
  employeeId Int
  title      String
  fileUrl    String
  type       String
  expiryDate DateTime?
  category   String
  issueDate  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "Document_employeeId_fkey")
}

model Department {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  isDefaultClearance      Boolean?                  @default(false)
  // HR-ops planning masters (management dashboard #18/#19):
  //   otBudgetHoursPerMonth — allotted OT hours/month for the dept (0 = no budget set)
  //   minDailyStrength      — minimum staff that must be present each day
  salaryTemplates         SalaryTemplate[]
  otBudgetHoursPerMonth   Int?                      @default(0)
  minDailyStrength        Int?                      @default(0)
  // Appraisal-cycle policy (management dashboard #20):
  //   appraisalCycleBasis  — 'DOJ' (anniversary from joining) or 'CALENDAR' (fixed month)
  //   appraisalPeriodMonths — 6 or 12 (used for DOJ basis)
  //   appraisalCalendarMonth — 1-12, the fixed month appraisals run (used for CALENDAR basis)
  appraisalCycleBasis     String?                   @default("DOJ")
  appraisalPeriodMonths   Int?                      @default(12)
  appraisalCalendarMonth  Int?
  employees               Employee[]
  Internship              Internship[]
  shiftTemplates          ShiftTemplate[]
  Job                     Job[]
  PerformanceFinalReview  PerformanceFinalReview[]
  PerformanceFormTemplate PerformanceFormTemplate[]
  PerformanceResponse     PerformanceResponse[]
  PerformanceSummary      PerformanceSummary[]
  Training                Training[]
  resignationClearances   ResignationClearance[]
  clearanceTemplateItems  ClearanceTemplateItem[]
  dataScopes              EmployeeDataScope[]
}

model Branch {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  location       String?
  attendanceMode AttendanceMode @default(MOBILE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  // Legal entity this location belongs to. Nullable so existing rows survive —
  // until it is set, the branch is treated as belonging to the default company.
  // Until now branch->company could only be inferred through employees.
  companyId Int?

  employees  Employee[]
  dataScopes EmployeeDataScope[]
  holidays   Holiday[]
}

enum AttendanceMode {
  BIOMETRIC
  MOBILE
  BOTH
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  employees   Employee[]
  permissions Permission[] @relation("PermissionToRole")
}

/// One capability, e.g. `admin.payroll.view`. `name` is the stable key the
/// frontend gates on; the other columns exist only so the admin matrix can
/// render itself without a hardcoded UI list.
model Permission {
  id        Int                  @id @default(autoincrement())
  name      String               @unique
  label     String?
  module    String?
  sortOrder Int                  @default(0)
  roles     Role[]               @relation("PermissionToRole")
  overrides EmployeePermission[]
}

/// Per-person exception to their role's grants.
///   granted = true  → extra access this role doesn't normally get
///   granted = false → explicit deny that beats the role grant
/// Replaces the hardcoded empId allowlist that used to live in the frontend.
model EmployeePermission {
  id           Int        @id @default(autoincrement())
  employeeId   Int
  permissionId Int
  granted      Boolean
  note         String?
  createdBy    Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([employeeId, permissionId])
  @@index([employeeId])
  @@index([permissionId])
}

/// Row-level data scope — the WHOSE-DATA axis, orthogonal to Permission's
/// WHICH-SCREEN axis. Permission decides that an HR can open the Employee
/// screen at all; this decides which employees they see once they are on it.
///
/// ZERO ROWS = GLOBAL. An employee with no scope rows sees everything, which is
/// exactly the behaviour every existing deployment has today. Branch isolation
/// is therefore opt-in per person: it starts the moment the first row is added
/// from the Data Scope screen, and nothing changes for clients who never use it.
///
/// Multiple rows are OR-ed, so one HR covering three branches is three rows —
/// which is what makes "same HR across branches" and "different HR per branch"
/// the same feature rather than two.
/// The scope target is expressed as real foreign keys rather than a
/// (scopeType, scopeId) pair: exactly one of branchId / departmentId is set per
/// row. That keeps referential integrity — deleting a branch cannot leave a row
/// behind that still grants access to it — and removes the invariant a
/// polymorphic scopeId would have to keep in sync.
model EmployeeDataScope {
  id           Int  @id @default(autoincrement())
  employeeId   Int
  /// Set for a branch grant; null on a department grant.
  branchId     Int?
  /// Set for a department grant; null on a branch grant.
  departmentId Int?

  /// Who granted it — this is a privilege-escalation surface, so it is audited.
  createdBy Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  employee   Employee    @relation("DataScopeOwner", fields: [employeeId], references: [id], onDelete: Cascade)
  grantedBy  Employee?   @relation("DataScopeGrantedBy", fields: [createdBy], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // MySQL treats NULLs as distinct in a unique index, which is exactly what is
  // wanted here: these constrain duplicate branch grants and duplicate
  // department grants independently, without blocking one because of the other.
  @@unique([employeeId, branchId])
  @@unique([employeeId, departmentId])
  @@index([employeeId])
  @@index([branchId])
  @@index([departmentId])
}

model Attendance {
  id                 Int       @id @default(autoincrement())
  employeeId         Int
  date               DateTime
  status             String
  checkIn            DateTime?
  checkOut           DateTime?
  createdBy          Int?
  reason             String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  approvedAt         DateTime?
  approvedBy         Int?
  attendanceApproval String?
  isForcedPresent    Boolean   @default(false)
  forcePresentId     Int?
  isPunchCorrected   Boolean   @default(false)
  punchCorrectionId  Int?
  isOverridden       Boolean   @default(false)
  overrideId         Int?
  // Which channel last wrote this day's check-in/out: 'BIOMETRIC' | 'MOBILE'.
  // Used to enforce "biometric wins" for BOTH-mode employees.
  source             String?
  employee           Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status])
}

model AttendanceSyncLog {
  id      Int      @id @default(autoincrement())
  runAt   DateTime @default(now())
  window  String
  success Boolean
  message String?
}

model ForcePresentAction {
  id             Int           @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  leaveRequestId Int?
  daysRestored   Float         @default(1)
  compOffGranted Boolean       @default(false)
  performedBy    Int
  reason         String
  createdAt      DateTime      @default(now())
  employee       Employee      @relation(fields: [employeeId], references: [id])
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id])
}

model PunchCorrectionLog {
  id             Int       @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  originalIn     DateTime?
  originalOut    DateTime?
  correctedIn    DateTime?
  correctedOut   DateTime?
  correctionType String
  reason         String
  performedBy    Int
  createdAt      DateTime  @default(now())
  employee       Employee  @relation(fields: [employeeId], references: [id])
}

model LeaveBalanceAdjustmentLog {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  leaveTypeId   Int
  year          Int
  adjustType    String
  days          Float
  balanceBefore Float
  balanceAfter  Float
  reason        String
  performedBy   Int
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id])
  leaveType     LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model AttendanceOverrideLog {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  date           DateTime
  originalStatus String?
  newStatus      String
  reason         String
  performedBy    Int
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id])
}

model WeekOffHolidayOverrideLog {
  id           Int      @id @default(autoincrement())
  employeeId   Int
  date         DateTime
  overrideType String
  prevStatus   String?
  newStatus    String
  autoCompOff  Boolean  @default(false)
  reason       String
  performedBy  Int
  createdAt    DateTime @default(now())
  employee     Employee @relation(fields: [employeeId], references: [id])
}

model AppraisalOverrideLog {
  id                Int      @id @default(autoincrement())
  appraisalFormId   Int
  employeeId        Int
  cycle             String
  prevOverallScore  Float?
  newOverallScore   Float?
  prevFinalDecision String?
  newFinalDecision  String?
  prevStatus        String?
  newStatus         String?
  prevComments      String?
  newComments       String?
  reason            String
  performedBy       Int
  createdAt         DateTime @default(now())
  employee          Employee @relation(fields: [employeeId], references: [id])
}

model LeaveType {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  description  String?
  carryForward Boolean @default(false)

  /// This type is unpaid by definition. When set, approving a request of this
  /// type forces the whole duration to lopUnits regardless of leave balance.
  ///
  /// Previously "LOP" was only a type NAME, while payroll decided paid-vs-unpaid
  /// from lopUnits — so a request could sit on the LOP type with lopUnits = 0 and
  /// be paid in full. One live row was doing exactly that.
  isLop                 Boolean                     @default(false)
  EmployeeLeaveBalance  EmployeeLeaveBalance[]
  LeaveRequest          LeaveRequest[]
  policies              LeavePolicy[]
  leaveAccruals         LeaveAccrual[]
  leaveLedgers          LeaveLedger[]
  balanceAdjustmentLogs LeaveBalanceAdjustmentLog[]
}

enum HalfDaySession {
  FIRST_HALF
  SECOND_HALF
}

model LeaveRequest {
  id                  Int                  @id @default(autoincrement())
  employeeId          Int
  leaveTypeId         Int
  startDate           DateTime
  endDate             DateTime
  reason              String
  status              LeaveStatus          @default(PENDING)
  approvedBy          Int?
  isHalfDay           Boolean?             @default(false)
  halfDaySession      HalfDaySession?
  // Paid-vs-LOP split, written at final approval. paidUnits is deducted from
  // EmployeeLeaveBalance; lopUnits is the overflow beyond balance (unpaid) and
  // is subtracted in payroll. Legacy rows keep both at 0 → treated as fully paid.
  paidUnits           Float                @default(0)
  lopUnits            Float                @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt
  declineReason       String?
  declinedBy          Int?
  approvedDate        DateTime?
  declinedDate        DateTime?
  hodDecidedAt        DateTime?
  hodDecision         ApprovalDecision     @default(PENDING)
  hodNote             String?
  hrDecidedAt         DateTime?
  hrDecision          ApprovalDecision     @default(PENDING)
  hrNote              String?
  inChargeDecidedAt   DateTime?
  inChargeDecision    ApprovalDecision     @default(PENDING)
  inChargeNote        String?
  prescriptionUrl     String?
  cancelledAt         DateTime?
  cancelledBy         Int?
  cancellationReason  String?
  // True when HR raised this leave on the employee's behalf via the HR
  // Corrections module (auto-approved + balance deducted immediately).
  appliedByHr         Boolean?             @default(false)
  appliedByHrId       Int?
  forcePresentActions ForcePresentAction[]
  employee            Employee             @relation(fields: [employeeId], references: [id])
  leaveType           LeaveType            @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

model ShiftTemplate {
  id                   Int                    @id @default(autoincrement())
  name                 String
  shiftType            ShiftType
  startTime            DateTime
  endTime              DateTime
  EmployeeShiftSetting EmployeeShiftSetting[]
  shiftApprovals       ShiftApproval[]
  ShiftAssignment      ShiftAssignment[]
  ShiftRotationItem    ShiftRotationItem[]
  departments          Department[] // shifts are assignable to any number of departments
}

model ShiftAssignment {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  shiftId      Int
  date         DateTime
  acknowledged Boolean       @default(false)
  assignedBy   Int?
  createdAt    DateTime?     @default(now())
  updatedAt    DateTime?     @default(now()) @updatedAt
  employee     Employee      @relation(fields: [employeeId], references: [id])
  shift        ShiftTemplate @relation(fields: [shiftId], references: [id])

  @@index([shiftId])
  @@index([employeeId, date])
}

model PermissionRequest {
  id                 Int               @id @default(autoincrement())
  employeeId         Int
  startTime          DateTime?
  endTime            DateTime?
  reason             String
  status             PermissionStatus  @default(PENDING)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  approvedBy         Int?
  approvedDate       DateTime?
  declineReason      String?
  declinedBy         Int?
  declinedDate       DateTime?
  permissionType     PermissionType?
  timing             PermissionTiming?
  day                DateTime
  hodDecidedAt       DateTime?
  hodDecision        ApprovalDecision  @default(PENDING)
  hodNote            String?
  hrDecidedAt        DateTime?
  hrDecision         ApprovalDecision  @default(PENDING)
  hrNote             String?
  inChargeDecidedAt  DateTime?
  inChargeDecision   ApprovalDecision  @default(PENDING)
  isHROverride       Boolean           @default(false)
  hrOverrideReason   String?
  cancelledAt        DateTime?
  cancelledBy        Int?
  cancellationReason String?
  employee           Employee          @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "PermissionRequest_employeeId_fkey")
}

model BagCheck {
  id         Int            @id @default(autoincrement())
  employeeId Int
  checkedBy  Int
  date       DateTime
  result     BagCheckResult
  remarks    String?
  imageUrl   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  employee   Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId], map: "BagCheck_employeeId_fkey")
}

model QuestionBank {
  id           Int        @id @default(autoincrement())
  name         String
  role         String?
  departmentId Int?
  difficulty   String?
  createdBy    Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  questions    Question[]
}

model Question {
  id               Int              @id @default(autoincrement())
  questionBankId   Int
  text             String
  type             String
  weight           Int
  correctAnswerIds String?
  evaluationTestId Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  EvaluationTest   EvaluationTest?  @relation(fields: [evaluationTestId], references: [id])
  questionBank     QuestionBank     @relation(fields: [questionBankId], references: [id])
  options          QuestionOption[]

  @@index([evaluationTestId], map: "Question_evaluationTestId_fkey")
  @@index([questionBankId], map: "Question_questionBankId_fkey")
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  questionId Int
  text       String
  isCorrect  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  question   Question @relation(fields: [questionId], references: [id])

  @@index([questionId], map: "QuestionOption_questionId_fkey")
}

model EvaluationTest {
  id                    Int                     @id @default(autoincrement())
  name                  String
  questionBankId        Int
  duration              Int
  passingPercent        Int
  maxAttempts           Int
