  managerReview    ManagerAppraisal?
  managementReview ManagementAppraisal?
  selfAppraisal    SelfAppraisal?
  selfAnswers      SelfAppraisalAnswer[]
  reviewAnswers    AppraisalReviewAnswer[]
  editRequests     AppraisalEditRequest[]
  editHistory      AppraisalEditHistory[]

  @@index([employeeId], map: "AppraisalForm_employeeId_fkey")
  @@index([status])
}

/// Captures any window in which an employee's appraisal & performance clocks
/// should NOT tick (maternity, long medical leave, sabbatical). One row =
/// one pause window. endDate = null means the pause is currently active.
/// Effective months worked = calendar months elapsed minus the sum of these
/// windows' days; auto-draft cron + period selector both consume this.
model EmployeeAppraisalPause {
  id         Int       @id @default(autoincrement())
  employeeId Int
  startDate  DateTime
  endDate    DateTime?
  reason     String    @db.Text
  createdBy  Int
  createdAt  DateTime  @default(now())
  endedBy    Int?
  endedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([employeeId, endDate])
}

/// Master question pool shared by all three review levels (In-charge,
/// Manager, Management). Per-level applicability is captured in `levels`
/// (e.g. ["INCHARGE","MANAGER","MANAGEMENT"]) so HR can scope a question to
/// a subset later without altering the schema.
model AppraisalReviewQuestion {
  id                   Int      @id @default(autoincrement())
  title                String // e.g. "Quality of Work"
  description          String?  @db.Text // one-line intent
  prompts              Json? // array of bullet questions
  aboveAverage         String?  @db.Text
  average              String?  @db.Text
  belowAverage         String?  @db.Text
  category             String? // CLINICAL | NONCLINICAL | PARAMEDICAL
  section              String?
  levels               Json     @default("[\"INCHARGE\",\"MANAGER\",\"MANAGEMENT\"]")
  // Subject targeting: which appraised employee gets this question. Each array
  // holds ids; empty [] means "no restriction on that axis". All four empty =
  // the question applies to every employee. Match is OR/union across axes.
  targetDepartmentIds  Json     @default("[]")
  targetDesignationIds Json     @default("[]")
  targetRoleIds        Json     @default("[]")
  targetEmployeeIds    Json     @default("[]")
  displayOrder         Int      @default(0)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  answers AppraisalReviewAnswer[]
}

/// One row per (appraisal, question, reviewer level). Single unified table
/// for In-charge / Manager / Management answers, replacing the column-based
/// ManagerAppraisal / ManagementAppraisal tables for new appraisals.
model AppraisalReviewAnswer {
  id              Int      @id @default(autoincrement())
  appraisalFormId Int
  questionId      Int
  level           String // INCHARGE | MANAGER | MANAGEMENT
  rating          Float?
  comments        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  appraisalForm AppraisalForm           @relation(fields: [appraisalFormId], references: [id])
  question      AppraisalReviewQuestion @relation(fields: [questionId], references: [id])

  @@unique([appraisalFormId, questionId, level])
  @@index([appraisalFormId, level])
  @@index([questionId])
}

model SelfAppraisalQuestion {
