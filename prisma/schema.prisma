  @@index([expiryDate])
}

model ClearanceTemplateItem {
  id           Int    @id @default(autoincrement())
  departmentId Int
  label        String
  orderNo      Int?

  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model ResignationClearanceItem {
  id             Int                 @id @default(autoincrement())
  clearanceId    Int
  templateItemId Int?
  label          String
  status         ClearanceItemStatus @default(PENDING)
  note           String?
  decidedAt      DateTime?
  verifierId     Int?

  clearance ResignationClearance @relation(fields: [clearanceId], references: [id])
  verifier  Employee?            @relation(fields: [verifierId], references: [id])

  @@index([clearanceId])
}

model LocationSession {
  id         Int           @id @default(autoincrement())
  employeeId Int
  name       String?
  startedAt  DateTime?
  endedAt    DateTime?
  status     SessionStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())

  // session summary
  totalDistance Float? // meters
  totalPoints   Int? // count

  employee  Employee               @relation(fields: [employeeId], references: [id])
  locations LocationPoint[]
  photos    LocationSessionPhoto[]

  @@index([employeeId])
  @@index([startedAt])
}

model LocationPoint {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?
  recordedAt DateTime @default(now())

  session LocationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([recordedAt])
  @@index([sessionId, recordedAt])
}

model LocationSessionPhoto {
  id         Int       @id @default(autoincrement())
  sessionId  Int
  url        String
  fileName   String
  latitude   Float?
  longitude  Float?
  capturedAt DateTime?
  capturedBy Int?
  createdAt  DateTime  @default(now())

  session LocationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model LeaveAccrual {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  leaveTypeId  Int
  year         Int
  month        Int?
  accrualType  AccrualType
  daysCredited Float
  createdAt    DateTime    @default(now())
  remarks      String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year, month])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveLedger {
  id Int @id @default(autoincrement())

  employeeId  Int
  leaveTypeId Int

  transactionDate DateTime @default(now())
  year            Int
  month           Int?

  referenceType LedgerReferenceType
  referenceId   Int?

  credit       Float @default(0)
  debit        Float @default(0)
  balanceAfter Float

  // AUDIT FIELDS
  action      LedgerAction // WHAT happened
  performedBy Int? // WHO did it
  performedAt DateTime      @default(now()) // WHEN
  source      LedgerSource? // FROM WHERE (API, CRON, IMPORT)

  remarks  String?
  metadata Json? // EXTRA DETAILS (optional)

  createdAt DateTime @default(now())

  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  performedByUser Employee? @relation("LedgerPerformedBy", fields: [performedBy], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([performedBy])
  @@index([year])
}

model LeaveMonthlySummary {
  id          Int @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int
  month       Int

  opening  Float
  credited Float
  used     Float
  lapsed   Float @default(0)
  closing  Float

  createdAt DateTime @default(now())

  @@unique([employeeId, leaveTypeId, year, month])
}

model LeaveYearlySummary {
  id          Int @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int

  opening  Float
  credited Float
  used     Float
  lapsed   Float @default(0)
  encashed Float @default(0)
  closing  Float

  createdAt DateTime @default(now())

  @@unique([employeeId, leaveTypeId, year])
}

model LeavePolicy {
  id Int @id @default(autoincrement())

  leaveTypeId Int
  name        String

  // ACCRUAL
  accrualType         AccrualType
  accrualRate         Float?
  accrualFrequency    String?
  accrualBasedOn      String?
  workingDaysRequired Int?

  isActive           Boolean @default(true)
  createdBy          Int?
  financialYearStart Int? // e.g. 2025

  // LIMITS
  maxBalance         Float?
  minLeavePerRequest Float?
  maxLeavePerRequest Float?

  // CARRY FORWARD
  carryForward           Boolean @default(false)
  maxCarryForward        Float?
  carryForwardExpiryDays Int?

  // LAPSING
  lapseAfterDays Int?

  // NEGATIVE BALANCE
  allowNegativeBalance Boolean @default(false)
  maxNegativeBalance   Float?

  // APPROVAL
  requiresApproval Boolean @default(true)
  approvalLevels   Int?

  // ELIGIBILITY
  applicableGender         Gender?
  applicableEmploymentType EmploymentType?
  applicableAfterDays      Int?
  includeProbation         Boolean         @default(true)

  // RULES
  enableSandwichRule Boolean @default(false)
  excludeWeekends    Boolean @default(true)
  excludeHolidays    Boolean @default(true)

  // DOCUMENTS
  requiresDocument          Boolean @default(false)
  documentRequiredAfterDays Float?

  // ENCASHMENT
  encashable Boolean @default(false)

  // DATES
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

