  finalComments String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  managerId     Int?
  // Snapshot of the employee's in-charge at HR verification time. Null when
  // the employee has no in-charge, in which case the flow skips the INCHARGE
  // step and goes Employee → Manager → Management.
  inchargeId    Int?

  // New fields for enhanced flow
  appraisalStartDate             DateTime?
  appraisalEndDate               DateTime?
  dueDate                        DateTime?
  hrVerifiedBy                   Int?
  hrVerifiedAt                   DateTime?
  selfAppraisalSubmittedAt       DateTime?
  inchargeAppraisalSubmittedAt   DateTime?
  // In-charge's supplementary summary (no final decision — that stays with
  // the manager). Nullable so existing rows are unaffected.
  inchargeOverallScore           Float?
  inchargeOverallComments        String?   @db.Text
  managerAppraisalSubmittedAt    DateTime?
  managementAppraisalSubmittedAt DateTime?
  hrReviewComments               String?   @db.Text
  hrRecommendations              String?   @db.Text
  hrApprovedBy                   Int?
  hrApprovedAt                   DateTime?

  employee         Employee                @relation(fields: [employeeId], references: [id])
