  @@index([interviewId])
  @@index([panelUserId])
  @@index([status])
}

model InterviewHRReview {
  id             Int       @id @default(autoincrement())
  interviewId    Int       @unique
  presentSalary  Int?
  payslip        Boolean?
  expectedSalary Int?
  grossOffer     Int?
  conclusion     String?
  remarks        String?
  reviewerUserId Int?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  expectedDoj    DateTime?
  noticePeriod   Int?
  interview      Interview @relation(fields: [interviewId], references: [id])

  @@index([reviewerUserId])
}

model OvertimeApproval {
  id         Int      @id @default(autoincrement())
  employeeId Int
  date       DateTime
  minutes    Int
  status     String

  // ── Employee-raised OT request ───────────────────────────────────────────
  // Until now OT could only appear two ways: derived automatically from a late
  // check-out, or keyed in by HR. An employee could not say "I need to stay
  // back for X" and get it sanctioned in advance, and nobody ever confirmed the
  // work the OT was claimed for actually got done.
  //
  /// AUTO | EMPLOYEE_REQUEST | MANUAL
  source          String    @default("AUTO")
  /// What the overtime is for. Required on an employee request — OT with no
  /// stated purpose is what makes overtime budgets unauditable.
  taskDescription String?   @db.Text
  /// What the employee asked for, kept separate from `minutes` (what actually
  /// happened) so over-runs are visible.
  expectedMinutes Int?
  requestedAt     DateTime?
  /// Manager's reason when rejecting.
  rejectionReason String?   @db.Text

  // ── Completion acknowledgement ───────────────────────────────────────────
  // Approval sanctions the hours; acknowledgement confirms the work landed.
  // null = not yet reviewed, true = done, false = not done.
  taskCompleted     Boolean?
  taskAckBy         Int?
  taskAckAt         DateTime?
  taskAckNote       String?   @db.Text
  createdAt         DateTime  @default(now())
  approvedAt        DateTime?
  scheduledEnd      DateTime?
  checkOut          DateTime?
  managerStatus     String    @default("PENDING")
  managerApprovedAt DateTime?
  managerId         Int?
  manuallyEntered   Boolean   @default(false)
  manualEntryBy     Int?
  manualEntryReason String?
  employee          Employee  @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date], name: "employeeId_date")
}

model EmployeeSurvey {
  id          Int              @id @default(autoincrement())
  employeeId  Int
  date        DateTime
  createdAt   DateTime         @default(now())
  status      String           @default("DRAFT")
  submittedAt DateTime?
  employee    Employee         @relation(fields: [employeeId], references: [id])
  responses   SurveyResponse[]

  @@index([employeeId], map: "EmployeeSurvey_employeeId_fkey")
}

model SurveyQuestion {
  id           Int              @id @default(autoincrement())
  section      String
  questionText String
  orderNo      Int
  responses    SurveyResponse[]
}

model SurveyResponse {
  id         Int            @id @default(autoincrement())
  surveyId   Int
  questionId Int
  answer     String
  question   SurveyQuestion @relation(fields: [questionId], references: [id])
  survey     EmployeeSurvey @relation(fields: [surveyId], references: [id])

  @@index([questionId], map: "SurveyResponse_questionId_fkey")
  @@index([surveyId], map: "SurveyResponse_surveyId_fkey")
}

model PerformanceFormTemplate {
  id           Int                   @id @default(autoincrement())
  departmentId Int
  cycle        String
  title        String                @default("Default")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @default(now()) @updatedAt
  department   Department            @relation(fields: [departmentId], references: [id])
  questions    PerformanceQuestion[]
  summaries    PerformanceSummary[]

  @@index([departmentId, cycle])
}

model PerformanceQuestion {
  id         Int                     @id @default(autoincrement())
  templateId Int
  category   String
  text       String
  orderNo    Int
  weight     Int?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @default(now()) @updatedAt
  template   PerformanceFormTemplate @relation(fields: [templateId], references: [id])
  responses  PerformanceResponse[]

  @@index([templateId], map: "PerformanceQuestion_templateId_fkey")
}

model PerformanceResponse {
  id           Int                 @id @default(autoincrement())
  employeeId   Int
  departmentId Int
  cycle        String
  questionId   Int
  period       EvaluationPeriod
  score        Int?
  reviewerId   Int?
  comments     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt
  department   Department          @relation(fields: [departmentId], references: [id])
  employee     Employee            @relation(fields: [employeeId], references: [id])
  question     PerformanceQuestion @relation(fields: [questionId], references: [id])

  @@unique([employeeId, cycle, period, questionId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([cycle])
  @@index([questionId], map: "PerformanceResponse_questionId_fkey")
}

model PerformanceSummary {
  id            Int                      @id @default(autoincrement())
  employeeId    Int
  departmentId  Int
  cycle         String
  period        EvaluationPeriod
  templateId    Int?
  marksScored   Int?
  overallPerf   String?
  employeeSig   String?                  @db.Text
  supervisorSig String?                  @db.Text
  hodSig        String?                  @db.Text
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @default(now()) @updatedAt
  department    Department               @relation(fields: [departmentId], references: [id])
  employee      Employee                 @relation(fields: [employeeId], references: [id])
  template      PerformanceFormTemplate? @relation(fields: [templateId], references: [id])

  @@unique([employeeId, cycle, period, templateId])
  @@index([employeeId, cycle])
  @@index([departmentId])
  @@index([templateId])
}

model PerformanceFinalReview {
  id              Int        @id @default(autoincrement())
  employeeId      Int
  departmentId    Int
  cycle           String
  appreciations   String?
  talents         String?
  overallComments String?
  employeeSig     String?    @db.Text
  supervisorSig   String?    @db.Text
  hrSig           String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  department      Department @relation(fields: [departmentId], references: [id])
  employee        Employee   @relation(fields: [employeeId], references: [id])

  @@index([departmentId], map: "PerformanceFinalReview_departmentId_fkey")
  @@index([employeeId], map: "PerformanceFinalReview_employeeId_fkey")
}

model ManpowerRequisition {
  id                    Int       @id @default(autoincrement())
  jobId                 Int?      @unique
  requestDate           DateTime
  designation           String?
  reasonType            String
  reasonDetails         String?
  vacancies             Int?
  minExperience         Int?
  maxExperience         Int?
  skills                String?   @db.LongText
  education             String?
  training              String?
  reasonBreakdown       Json?
  eduSSC                Boolean?
  eduDiploma            Boolean?
  eduBachelor           Boolean?
  eduMaster             Boolean?
  eduOther              String?
  urgent                Boolean?  @default(false)
  duration              String?
  reportingTo           String?
  raisedBy              String?
  raisedBySign          String?   @db.LongText
  raisedByDate          DateTime?
  raisedByComments      String?
  approvedByHoD         String?
  hodSign               String?   @db.LongText
  approvedByHoDDate     DateTime?
  approvedByHoDComments String?
  approvedBySMO         String?
  smoSign               String?   @db.LongText
  approvedBySMODate     DateTime?
  approvedBySMOComments String?
  receivedByHR          String?
  hrSign                String?   @db.LongText
  receivedByHRDate      DateTime?
  receivedByHRComments  String?
  hrReferenceNo         String?
  salaryRange           String?
  source                String?
  actionTaken           String?
  closedOn              DateTime?
  hrRemarks             String?
  status                String    @default("RAISED")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  departmentId          Int?
  eduOtherDetail        Boolean?
  eduBachelorDetail     String?
  eduDiplomaDetail      String?
  eduMasterDetail       String?
  eduSSCDetail          String?
  title                 String?
  hodRejectedBy         String?
  hodRejectedComments   String?
  hodRejectedDate       DateTime?
  hrRejectedBy          String?
  hrRejectedComments    String?
  hrRejectedDate        DateTime?
  smoRejectedBy         String?
  smoRejectedComments   String?
  smoRejectedDate       DateTime?

  // ── Withdrawn (by the raiser, or HR force-cancel for orphans) ──
  // Distinct from REJECTED — withdrawn means no judgment was made,
  // the raiser pulled it back. Important for analytics so "rejected by
  // HOD" doesn't get inflated by raiser changes-of-mind.
  withdrawnBy      String?
  withdrawnByEmpId Int?
  withdrawnDate    DateTime?
  withdrawnReason  String?

  // ── Strong FKs back to the Employee table ───────────────────
  // Existing String columns (raisedBy, approvedByHoD, etc.) keep the
  // *display name / signature label* shown on the printed requisition
  // form. These Int columns are the system-of-record for "who" — used
  // by filters, role checks, and notifications. Backfilled from the
  // String columns via prisma/backfillRequisitionRaisers.ts.
  raisedByEmployeeId Int?
  approvedByHoDEmpId Int?
  approvedBySMOEmpId Int?
  receivedByHREmpId  Int?

  raisedByEmployee    Employee? @relation("ManpowerRaisedBy", fields: [raisedByEmployeeId], references: [id])
  hodApproverEmployee Employee? @relation("ManpowerApprovedHoD", fields: [approvedByHoDEmpId], references: [id])
  smoApproverEmployee Employee? @relation("ManpowerApprovedSMO", fields: [approvedBySMOEmpId], references: [id])
  hrReceiverEmployee  Employee? @relation("ManpowerReceivedHR", fields: [receivedByHREmpId], references: [id])

  job Job? @relation(fields: [jobId], references: [id])

  @@index([raisedByEmployeeId])
  @@index([approvedByHoDEmpId])
  @@index([approvedBySMOEmpId])
  @@index([receivedByHREmpId])
}

model Grievance {
  id                       Int                        @id @default(autoincrement())
  employeeId               Int
  title                    String
  description              String                     @db.LongText
  category                 String?
  status                   GrievanceStatus            @default(OPEN)
  committeeId              Int? // which Grievance Committee is handling this case
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  ComplaintAcknowledgement ComplaintAcknowledgement[]
  employee                 Employee                   @relation(fields: [employeeId], references: [id])
  committee                Committee?                 @relation(fields: [committeeId], references: [id])
  comments                 GrievanceComment[]

  @@index([status])
  @@index([employeeId], map: "Grievance_employeeId_fkey")
  @@index([committeeId])
}

model GrievanceComment {
  id          Int       @id @default(autoincrement())
  grievanceId Int
  employeeId  Int
  comment     String    @db.LongText
  createdAt   DateTime  @default(now())
  employee    Employee  @relation(fields: [employeeId], references: [id])
  grievance   Grievance @relation(fields: [grievanceId], references: [id])

  @@index([employeeId], map: "GrievanceComment_employeeId_fkey")
  @@index([grievanceId], map: "GrievanceComment_grievanceId_fkey")
}

model PoshCase {
  id                       Int                        @id @default(autoincrement())
  complainantId            Int
  accusedId                Int
  description              String                     @db.LongText
  status                   PoshStatus                 @default(FILED)
  committeeNote            String?                    @db.LongText
  committeeId              Int? // which ICC is handling this case
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @default(now()) @updatedAt
  ComplaintAcknowledgement ComplaintAcknowledgement[]
  accused                  Employee                   @relation("AccusedCases", fields: [accusedId], references: [id])
  complainant              Employee                   @relation("ComplainantCases", fields: [complainantId], references: [id])
  committee                Committee?                 @relation(fields: [committeeId], references: [id])
  hearings                 PoshHearing[]

  @@index([status])
  @@index([accusedId], map: "PoshCase_accusedId_fkey")
  @@index([complainantId], map: "PoshCase_complainantId_fkey")
  @@index([committeeId])
}

model PoshHearing {
  id        Int                   @id @default(autoincrement())
  poshId    Int
  date      DateTime
  notes     String?               @db.LongText
  outcome   String?               @db.LongText
  createdAt DateTime              @default(now())
  updatedAt DateTime              @default(now()) @updatedAt
  poshCase  PoshCase              @relation(fields: [poshId], references: [id])
  attendees PoshHearingAttendee[]

  @@index([poshId], map: "PoshHearing_poshId_fkey")
}

/// ──────────────────────────────────────────────────────────────────────
///  POSH HEARING ATTENDEE — records who attended each hearing.
///  Provides the quorum-proof audit trail required if any decision is
///  challenged. Each row links a hearing to one committee member (the
///  CommitteeMember row, which itself can be internal OR external) plus
///  an attended/absent flag and optional remarks.
/// ──────────────────────────────────────────────────────────────────────
model PoshHearingAttendee {
  id                Int      @id @default(autoincrement())
  hearingId         Int
  committeeMemberId Int
  attended          Boolean  @default(true)
  remarks           String?  @db.LongText
  createdAt         DateTime @default(now())

  hearing PoshHearing     @relation(fields: [hearingId], references: [id])
  member  CommitteeMember @relation(fields: [committeeMemberId], references: [id])

  @@unique([hearingId, committeeMemberId])
  @@index([hearingId])
  @@index([committeeMemberId])
}

model Training {
  id                 Int                  @id @default(autoincrement())
  title              String
  description        String?              @db.LongText
  objectives         String?              @db.Text
  trainerType        String?
  trainerId          Int?
  trainerName        String?
  trainerOrg         String?
  mode               String?
  location           String?
  startDate          DateTime?
  endDate            DateTime?
  status             TrainingStatus       @default(DRAFT)
  durationHours      Float?
  departmentId       Int?
  createdBy          Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  trainers           Json?
  department         Department?          @relation(fields: [departmentId], references: [id])
