// ─── Incident Management ─────────────────────────────────────────────
// `Incident` is intentionally industry-neutral. Categories live in a
// separate `IncidentCategory` table so each customer (factory, IT,
// retail, hospital, etc.) can configure their own list at deployment.
// `status` tracks where in the workflow the case is; `outcome` tracks
// what the investigation concluded — they are orthogonal.
model Incident {
  id Int @id @default(autoincrement())

  // Who & what
  title             String
  description       String            @db.LongText
  categoryId        Int? // FK → IncidentCategory (null only for legacy rows)
  category          IncidentCategory? @relation(fields: [categoryId], references: [id])
  subcategory       String?
  severity          IncidentSeverity  @default(MEDIUM)
  status            IncidentStatus    @default(OPEN)
  outcome           IncidentOutcome?
  outcomeRecordedAt DateTime?
  outcomeRecordedBy Int?

  // Discretion
  isAnonymous     Boolean @default(false)
  confidentiality String  @default("STANDARD") // STANDARD · HR_PRIVATE · MGMT_ONLY

  // Generic compliance flags — let any framework (ISO 45001 / 27001 / DPDP /
  // POSH / Factories Act, etc.) hook into the same column without bloating
  // the model with framework-specific booleans.
  requiresRCA            Boolean @default(false)
  requiresExternalReport Boolean @default(false)

  // When & where
  // Defaults to now() purely so prisma db push can apply against existing
  // rows. The controller still treats this as a real "when did it happen"
  // value supplied by the reporter — defaulting only kicks in if the
  // caller forgets to send it.
  incidentDate DateTime @default(now())
  reportedAt   DateTime @default(now())
  location     String?
  departmentId Int? // dept where it occurred (may differ from employee's dept)

  // People — every "person" field is nullable to support anonymous reports
  // and incidents without a specific accused (e.g. equipment failure).
  employeeId    Int? // person involved / accused
  reportedBy    Int? // null when isAnonymous = true
  assignedTo    Int? // investigator
  reviewerEmpId Int? // HR / HOD reviewer who signs off

  // SLA
  dueDate        DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?

  // Resolution (filled in as the investigation progresses)
  rootCause        String? @db.Text
  actionTaken      String? @db.Text // disciplinary / corrective action
  preventiveAction String? @db.Text
  rejectionReason  String?

  // When outcome = FALSE_REPORT, capture whether HR took counter-action
  // against the reporter (filing a malicious complaint is itself misconduct
  // under most policies).
  falseReportConsequenceTaken Boolean @default(false)
  falseReportConsequenceNote  String? @db.Text

  // External reporting (industry-agnostic — police, regulator, ISO auditor,
  // data-protection board, factory inspector, etc.)
  reportedToAuthority Boolean   @default(false)
  authorityName       String?
  authorityReportNote String?   @db.Text
  authorityReportedAt DateTime?

  // Linked incidents — same root cause grouped together
  parentIncidentId Int?
  parentIncident   Incident?  @relation("IncidentLinks", fields: [parentIncidentId], references: [id])
  linkedIncidents  Incident[] @relation("IncidentLinks")

  // Legacy single-attachment column kept for backward compat with old rows.
  // New writes use the IncidentAttachment table for multi-file support.
  attachment String?

  // Phase 4 — public anonymous-report tracking. Set when an incident is
  // filed via the public form (no login). The reporter can come back to
  // GET /api/incidents/public/track/:token to read sanitised status info
  // (no comments, no internal names).
  publicTrackingToken String?   @unique
  // Last time the auto-escalation cron acted on this incident — used to
  // avoid re-escalating the same row every day forever.
  lastEscalatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations
  employee    Employee?            @relation("IncidentEmployee", fields: [employeeId], references: [id])
  reporter    Employee?            @relation("IncidentReporter", fields: [reportedBy], references: [id])
  attachments IncidentAttachment[]
  comments    IncidentComment[]
  witnesses   IncidentWitness[]
  auditLogs   IncidentAuditLog[]
  // Phase 2 relations
  capaActions IncidentCAPA[]
  rca         IncidentRCA?

  @@index([employeeId])
  @@index([reportedBy])
  @@index([assignedTo])
  @@index([categoryId])
  @@index([status])
  @@index([severity])
  @@index([incidentDate])
  @@index([dueDate])
}

// Configurable category catalogue — each org tunes their own list.
// `defaultAssigneeRoleId` lets new incidents auto-route to a role
// (e.g. Safety → EHS Manager, Cyber → IT Head, Misconduct → HR Head).
model IncidentCategory {
  id                              Int      @id @default(autoincrement())
  name                            String   @unique
  description                     String?
  defaultSeverity                 String? // pre-fill suggestion (LOW/MEDIUM/HIGH/CRITICAL)
  defaultSlaHours                 Int? // SLA in hours from reportedAt
  defaultAssigneeRoleId           Int? // role for auto-assign
  isAnonymousAllowed              Boolean  @default(true) // per-category whistleblower toggle
  requiresRCAByDefault            Boolean  @default(false)
  requiresExternalReportByDefault Boolean  @default(false)
  isActive                        Boolean  @default(true)
  sortOrder                       Int      @default(0)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @default(now()) @updatedAt

  incidents Incident[]
}

model IncidentAttachment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  fileName   String
  fileUrl    String
  uploadedBy Int?
  uploadedAt DateTime @default(now())
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentComment {
  id         Int      @id @default(autoincrement())
  incidentId Int
  authorId   Int // employee posting the note
  body       String   @db.Text
  isInternal Boolean  @default(false) // visible only to investigators / HR
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model IncidentWitness {
  id           Int      @id @default(autoincrement())
  incidentId   Int
  // A witness can be an employee (linked) or an external person (free text).
  witnessEmpId Int?
  witnessName  String?
  contactInfo  String?
  statement    String?  @db.Text
  recordedAt   DateTime @default(now())
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

// Phase 2 — Investigation tools

// Corrective & Preventive Actions tied to an incident. One incident can
// spawn multiple CAPAs (e.g. one corrective + two preventive). Each has
// its own owner and lifecycle (PENDING → IN_PROGRESS → DONE / CANCELLED).
// Industry-neutral: same shape works for ISO 9001 quality NCRs, ISO 45001
// safety actions, ISO 27001 security controls, etc.
model IncidentCAPA {
  id            Int       @id @default(autoincrement())
  incidentId    Int
  // CORRECTIVE = fix the issue that just happened.
  // PREVENTIVE = make sure it doesn't happen again.
  type          String    @default("CORRECTIVE")
  description   String    @db.Text
  ownerId       Int? // employee accountable for executing the action
  dueDate       DateTime?
  status        String    @default("PENDING") // PENDING / IN_PROGRESS / DONE / CANCELLED
  completedAt   DateTime?
  completedNote String?   @db.Text
  createdBy     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}

// Structured Root-Cause Analysis. One RCA per incident (1:1). Supports two
// industry-standard methods — 5-Why (text chain) and Fishbone / Ishikawa
// (categorical causes). The `method` field discriminates which fields are
// meaningful; the others stay null.
model IncidentRCA {
  id         Int    @id @default(autoincrement())
  incidentId Int    @unique
  method     String @default("FIVE_WHY") // FIVE_WHY / FISHBONE

  // Common
  problemStatement String? @db.Text
  rootCauseSummary String? @db.Text

  // 5-Why — five chained "why?" questions drilling toward the root cause
  why1 String? @db.Text
  why2 String? @db.Text
  why3 String? @db.Text
  why4 String? @db.Text
  why5 String? @db.Text

  // Fishbone — six classic cause categories (the "6Ms")
  causesPeople      String? @db.Text
  causesProcess     String? @db.Text
  causesEquipment   String? @db.Text
  causesEnvironment String? @db.Text
  causesMaterial    String? @db.Text
  causesMethod      String? @db.Text

  conductedBy Int?
  conductedAt DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
}

// Append-only audit log of every state change / assignment / outcome.
// Required for HR/legal traceability; also feeds the activity feed in the UI.
model IncidentAuditLog {
  id          Int      @id @default(autoincrement())
  incidentId  Int
  action      String // STATUS_CHANGED / ASSIGNED / COMMENTED / OUTCOME / etc.
  fromValue   String?
  toValue     String?
  note        String?  @db.Text
  performedBy Int?
  performedAt DateTime @default(now())
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model Designation {
