  contentQuality Int?
  relevance      Int?
  suggestions    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  employee       Employee @relation(fields: [employeeId], references: [id])
  training       Training @relation(fields: [trainingId], references: [id])

  @@unique([trainingId, employeeId])
  @@index([trainingId])
  @@index([employeeId], map: "TrainingFeedback_employeeId_fkey")
}

model ComplaintAcknowledgement {
  id             Int        @id @default(autoincrement())
  employeeId     Int
  grievanceId    Int?
  poshCaseId     Int?
  acknowledgedAt DateTime   @default(now())
  createdAt      DateTime   @default(now())
  employee       Employee   @relation(fields: [employeeId], references: [id])
  grievance      Grievance? @relation(fields: [grievanceId], references: [id])
  poshCase       PoshCase?  @relation(fields: [poshCaseId], references: [id])

  @@index([employeeId])
  @@index([grievanceId])
  @@index([poshCaseId])
}

model EmployeeLeaveBalance {
  id             Int             @id @default(autoincrement())
  employeeId     Int
  leaveTypeId    Int?
  permissionType PermissionType?
  category       BalanceCategory
  year           Int
  isUnlimited    Boolean?        @default(false)
  totalAllowed   Float           @default(0)
  used           Float           @default(0)
  halfDayUsed    Float?          @default(0)
  leaveType      LeaveType?      @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@unique([employeeId, permissionType, year])
  @@index([leaveTypeId], map: "EmployeeLeaveBalance_leaveTypeId_fkey")
}

model TrainingAttendance {
  id         Int       @id @default(autoincrement())
  trainingId Int
  employeeId Int
  date       DateTime
  status     String
  markedAt   DateTime?
  markedBy   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  employee   Employee  @relation(fields: [employeeId], references: [id])
  training   Training  @relation(fields: [trainingId], references: [id])

  @@unique([trainingId, employeeId, date])
  @@index([trainingId])
  @@index([employeeId])
}

model Incident {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  reportedBy  Int
  title       String
  description String   @db.LongText
  status      String
  attachment  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  employee    Employee @relation("IncidentEmployee", fields: [employeeId], references: [id])
  reporter    Employee @relation("IncidentReporter", fields: [reportedBy], references: [id])

  @@index([employeeId], map: "Incident_employeeId_fkey")
  @@index([reportedBy], map: "Incident_reportedBy_fkey")
}

model Designation {
  id              Int                    @id @default(autoincrement())
  name            String                 @unique
  isActive        Boolean                @default(true)
  employees       Employee[]
  ratingQuestions WeeklyRatingQuestion[]
}

model DeviceToken {
  id         Int      @id @default(autoincrement())
  employeeId Int
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
}

model LateLoginLog {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  date        DateTime
  shiftStart  DateTime
  checkIn     DateTime
  lateMinutes Int
  source      String?
  createdAt   DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

model MobileAuthSession {
  id            String   @id @default(uuid())
  employeeId    Int
  phoneVerified Boolean  @default(false)
  emailVerified Boolean  @default(false)
  identityOk    Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  employee      Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AttendanceNotificationLog {
  id        Int      @id @default(autoincrement())
  uniqueKey String   @unique
  date      DateTime
  shiftId   Int
  runAt     DateTime
  lateCount Int
  createdAt DateTime @default(now())
}

model HolidayCalendar {
  id        Int       @id @default(autoincrement())
  year      Int       @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  holidays  Holiday[]
}

model Holiday {
  id          Int             @id @default(autoincrement())
  calendarId  Int
  title       String
  date        DateTime
  description String?
  isOptional  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  calendar    HolidayCalendar @relation(fields: [calendarId], references: [id])

  @@unique([calendarId, date])
  @@index([date])
}

model ShiftApproval {
  id                  Int                   @id @default(autoincrement())
  employeeId          Int
  rmDecision          ApprovalDecision      @default(PENDING)
  rmDecidedAt         DateTime?
  hrDecision          ApprovalDecision      @default(PENDING)
  hrDecidedAt         DateTime?
  status              ApprovalDecision      @default(PENDING)
  fixedShiftId        Int?
  hasIncharge         Boolean
  patternId           Int?
  month               Int?
  year                Int?
  isMonthly           Boolean?              @default(false)
  weekOffConfig       Json?
  requestedAt         DateTime              @default(now())
  requestedBy         Int
  requestedMode       ShiftAssignMode
  startDate           DateTime
  appliedAt           DateTime?
  hrRejectReason      String?               @db.Text
  rmRejectReason      String?               @db.Text
  employee            Employee              @relation(fields: [employeeId], references: [id])
  fixedShift          ShiftTemplate?        @relation(fields: [fixedShiftId], references: [id])
  pattern             ShiftRotationPattern? @relation(fields: [patternId], references: [id])
  requestedByEmployee Employee              @relation("ShiftApprovalRequestedBy", fields: [requestedBy], references: [id])

  @@index([employeeId])
  @@index([fixedShiftId])
  @@index([patternId])
  @@index([requestedBy])
}

model Sabbatical {
  id         Int              @id @default(autoincrement())
  employeeId Int
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     SabbaticalStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model CompOffCredit {
  id            Int       @id @default(autoincrement())
  employeeId    Int
  workDate      DateTime
  expiryDate    DateTime
  used          Boolean   @default(false)
  usedOn        DateTime?
  leaveId       Int?
  isManualGrant Boolean   @default(false)
  grantedBy     Int?
  grantReason   String?
  createdAt     DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([expiryDate])
}

model ClearanceTemplateItem {
  id           Int    @id @default(autoincrement())
  departmentId Int
  label        String
  orderNo      Int?

  department Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model ResignationClearanceItem {
  id             Int                 @id @default(autoincrement())
  clearanceId    Int
  templateItemId Int?
  label          String
  status         ClearanceItemStatus @default(PENDING)
  note           String?
  decidedAt      DateTime?
  verifierId     Int?

  clearance ResignationClearance @relation(fields: [clearanceId], references: [id])
  verifier  Employee?            @relation(fields: [verifierId], references: [id])

  @@index([clearanceId])
}

model LocationSession {
  id         Int           @id @default(autoincrement())
  employeeId Int
  name       String?
  startedAt  DateTime?
  endedAt    DateTime?
  status     SessionStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())

  // session summary
  totalDistance Float? // meters
  totalPoints   Int? // count

  employee  Employee               @relation(fields: [employeeId], references: [id])
  locations LocationPoint[]
  photos    LocationSessionPhoto[]

  @@index([employeeId])
  @@index([startedAt])
}

model LocationPoint {
  id         Int      @id @default(autoincrement())
  sessionId  Int
  latitude   Float
  longitude  Float
  accuracy   Float?
  speed      Float?
  recordedAt DateTime @default(now())

  session LocationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([recordedAt])
  @@index([sessionId, recordedAt])
}

model LocationSessionPhoto {
  id         Int       @id @default(autoincrement())
  sessionId  Int
  url        String
  fileName   String
  latitude   Float?
  longitude  Float?
  capturedAt DateTime?
  capturedBy Int?
  createdAt  DateTime  @default(now())

  session LocationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
}

model LeaveAccrual {
  id           Int         @id @default(autoincrement())
  employeeId   Int
  leaveTypeId  Int
  year         Int
  month        Int?
  accrualType  AccrualType
  daysCredited Float
  createdAt    DateTime    @default(now())
  remarks      String?

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year, month])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model LeaveLedger {
  id Int @id @default(autoincrement())

  employeeId  Int
  leaveTypeId Int

  transactionDate DateTime @default(now())
  year            Int
  month           Int?

  referenceType LedgerReferenceType
  referenceId   Int?

  credit       Float @default(0)
  debit        Float @default(0)
  balanceAfter Float

  // AUDIT FIELDS
  action      LedgerAction // WHAT happened
  performedBy Int? // WHO did it
  performedAt DateTime      @default(now()) // WHEN
  source      LedgerSource? // FROM WHERE (API, CRON, IMPORT)

  remarks  String?
  metadata Json? // EXTRA DETAILS (optional)

  createdAt DateTime @default(now())

  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  performedByUser Employee? @relation("LedgerPerformedBy", fields: [performedBy], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([performedBy])
  @@index([year])
}

model LeaveMonthlySummary {
  id          Int @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int
  month       Int

  opening  Float
  credited Float
  used     Float
  lapsed   Float @default(0)
  closing  Float

  createdAt DateTime @default(now())

  @@unique([employeeId, leaveTypeId, year, month])
}

model LeaveYearlySummary {
  id          Int @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int

  opening  Float
  credited Float
  used     Float
  lapsed   Float @default(0)
  encashed Float @default(0)
  closing  Float

  createdAt DateTime @default(now())

  @@unique([employeeId, leaveTypeId, year])
}

model LeavePolicy {
  id Int @id @default(autoincrement())

  leaveTypeId Int
  name        String

  // ACCRUAL
  accrualType         AccrualType
  accrualRate         Float?
  accrualFrequency    String?
  accrualBasedOn      String?
  workingDaysRequired Int?

  isActive           Boolean @default(true)
  createdBy          Int?
  financialYearStart Int? // e.g. 2025

  // LIMITS
  maxBalance         Float?
  minLeavePerRequest Float?
  maxLeavePerRequest Float?

  // CARRY FORWARD
  carryForward           Boolean @default(false)
  maxCarryForward        Float?
  carryForwardExpiryDays Int?

  // LAPSING
  lapseAfterDays Int?

  // NEGATIVE BALANCE
  allowNegativeBalance Boolean @default(false)
  maxNegativeBalance   Float?

  // APPROVAL
  requiresApproval Boolean @default(true)
  approvalLevels   Int?

  // ELIGIBILITY
  applicableGender         Gender?
  applicableEmploymentType EmploymentType?
  applicableAfterDays      Int?
  includeProbation         Boolean         @default(true)

  // RULES
  enableSandwichRule Boolean @default(false)
  excludeWeekends    Boolean @default(true)
  excludeHolidays    Boolean @default(true)

  // DOCUMENTS
  requiresDocument          Boolean @default(false)
  documentRequiredAfterDays Float?

  // ENCASHMENT
  encashable Boolean @default(false)

  // DATES
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

enum LedgerAction {
  CREDIT // monthly credit, SL yearly
  DEBIT // leave taken
  LAPSE // year end expiry
  ENCASHMENT // EL encash
  ADJUSTMENT // manual correction
  OPENING_BALANCE // excel import
  CANCELLATION // leave cancelled (force present or manual)
}

enum LedgerSource {
  SYSTEM // cron jobs
  ADMIN // manual HR action
  EMPLOYEE // leave request
  IMPORT // excel upload
}

