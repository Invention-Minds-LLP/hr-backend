}

model InternshipEvaluation {
  id             Int                       @id @default(autoincrement())
  internshipId   Int
  evaluatorId    Int? // employee (mentor/HR) who evaluated; bare Int like Internship.mentorId
  periodLabel    String? // e.g. "Week 2", "Month 1", "Final"
