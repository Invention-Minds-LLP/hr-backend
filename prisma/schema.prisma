model InternshipStipend {
  id           Int           @id @default(autoincrement())
  internshipId Int
  periodMonth  DateTime // first day of the month this disbursement covers
  amount       Int
  status       StipendStatus @default(PENDING)
  paidAt       DateTime?
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  internship   Internship    @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([internshipId, periodMonth])
  @@index([internshipId])
  @@index([status])
