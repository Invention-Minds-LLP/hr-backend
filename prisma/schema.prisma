  employee        Employee  @relation(fields: [employeeId], references: [id])
  leaveType       LeaveType @relation(fields: [leaveTypeId], references: [id])
  performedByUser Employee? @relation("LedgerPerformedBy", fields: [performedBy], references: [id])

  @@index([employeeId])
  @@index([leaveTypeId])
  @@index([performedBy])
  @@index([year])
