  targets          Json?
  trainingIds      Json?
  pipStartDate     DateTime?
  pipEndDate       DateTime?
  extendedCount    Int       @default(0)
  warningDate      DateTime?
  responseDeadline DateTime?
  noticePeriodDays Int?
  terminationReason String?  @db.Text
  remarks          String?   @db.Text
  initiatedBy      Int
  closedAt         DateTime?
  closedBy         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee      Employee               @relation(fields: [employeeId], references: [id])
  weeklyReviews PIPWeeklyReview[]
  emailLogs     PIPEmailLog[]
  responses     PIPEmployeeResponse[]

  @@index([employeeId])
  @@index([status])
  @@index([triggerMonth])
}

model PIPWeeklyReview {
  id          Int      @id @default(autoincrement())
  pipId       Int
  weekNumber  Int
  reviewDate  DateTime
  weeklyScore Float?
  status      String
  remarks     String?  @db.Text
  reviewedBy  Int
  createdAt   DateTime @default(now())

  pip EmployeePIP @relation(fields: [pipId], references: [id])

  @@index([pipId])
}

model PIPEmailLog {
  id            Int      @id @default(autoincrement())
  pipId         Int?
  employeeId    Int
  templateId    Int?
  sentTo        String
  subject       String
  body          String   @db.LongText
  sentBy        Int
  sentAt        DateTime @default(now())
  status        String   @default("SENT")
  errorMessage  String?  @db.Text
  responseToken String?  @unique

  pip      EmployeePIP?      @relation(fields: [pipId], references: [id])
  template PIPEmailTemplate? @relation(fields: [templateId], references: [id])
  employee Employee          @relation(fields: [employeeId], references: [id])

  @@index([pipId])
  @@index([employeeId])
  @@index([sentAt])
}

enum PIPResponseMethod {
  EMAIL_LINK
  HR_LOGGED
  EMPLOYEE_SELF
}

// ─── Incident Management enums ──────────────────────────────────────
// `IncidentStatus` tracks where in the workflow a case sits.
// `IncidentOutcome` is filled in when investigation closes — it captures
// the verdict, separate from where in the workflow the case is.
enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  INVESTIGATING
  ESCALATED
  RESOLVED
  CLOSED
  REJECTED
  DUPLICATE
  WITHDRAWN
}

enum IncidentOutcome {
  SUBSTANTIATED              // proven true ("convicted")
  PARTIALLY_SUBSTANTIATED
  UNSUBSTANTIATED            // can't be proven (≠ false)
  FALSE_REPORT               // proven knowingly false ("wrongly created")
  WITHDRAWN
  DUPLICATE
  NOT_A_VIOLATION
}

model PIPEmployeeResponse {
  id             Int                @id @default(autoincrement())
  pipId          Int
  employeeId     Int
  method         PIPResponseMethod
  responseText   String             @db.Text
  tokenUsed      String?
  respondedAt    DateTime           @default(now())
  acknowledgedBy Int?
  acknowledgedAt DateTime?
  createdAt      DateTime           @default(now())

  pip      EmployeePIP @relation(fields: [pipId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])

  @@index([pipId])
  @@index([employeeId])
}
